#!/usr/bin/env bash
# netkit v4 — categorised network toolkit dashboard for a Pi 5 handheld
# Usage: netkit              (interactive dashboard)
#        netkit dash         (tiled live view in tmux)
#        netkit report       (markdown site snapshot)
#        netkit sweep        (full commissioning sweep → branded report)
#        netkit setup        (install/refresh extra dependencies)
#        netkit selftest     (bench check)
#        netkit doctor       (check prebuilt-binary matchers against GitHub)
#        netkit site [name]  (site profiles: prefill prompts per location)
#        netkit autostart on|off   (boot the unit straight into netkit)
#        netkit update [URL] | uninstall | version | help
set -uo pipefail

NETKIT_VERSION="4.2.0"
NETKIT_BIN="/usr/local/bin/netkit"
NETKIT_BIN_DIR="/usr/local/bin"
NETKIT_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/netkit"
site_dir="$NETKIT_CFG_DIR/sites"

# ---------- helpers ----------
have() { command -v "$1" >/dev/null 2>&1; }

# ---------- colour ----------
# Initialised unconditionally (set -u safe); populated only for a real colour
# terminal. Honours NO_COLOR and a non-tty stdout (e.g. output redirected to a file).
C_ACCENT="212"   # gum 256-colour code — gum styling only, unaffected by NO_COLOR
C_HDR=""; C_OK=""; C_WARN=""; C_ERR=""; C_RST=""
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ]; then
  C_HDR=$'\033[1;35m'; C_OK=$'\033[1;32m'; C_WARN=$'\033[1;33m'
  C_ERR=$'\033[1;31m'; C_RST=$'\033[0m'
fi

# require <cmd> [hint]: 0 if present. If missing, offer to run setup now, then
# return whether the tool is present — so the action proceeds if setup fixed it,
# and bails cleanly otherwise.  (do_setup is defined later; resolved at call time.)
require() {
  local cmd="$1" hint="${2:-}"
  have "$cmd" && return 0
  clear
  warn "$cmd not installed${hint:+  ($hint)}"
  if have gum; then
    gum confirm "Run 'netkit setup' now?" && { do_setup; pause; }
  else
    local a; read -rp "Run 'netkit setup' now? (y/N): " a
    case "$a" in y|Y|yes|YES) do_setup; pause ;; esac
  fi
  have "$cmd"
}

banner() {
  if have gum; then
    gum style --border rounded --padding "0 2" \
      --border-foreground "$C_ACCENT" --foreground "$C_ACCENT" \
      "netkit" "network toolkit"
  else
    echo "== netkit =="
  fi
}

# menu "Header" "key|Label" ... -> prints the chosen key (empty if cancelled).
# Plain arrow/scroll list (gum choose) — a search box (gum filter) is the wrong
# widget here: scrolling injects stray input into the query and re-filters the list.
menu() {
  local header="$1"; shift
  local labels=() keys=() pair
  for pair in "$@"; do keys+=("${pair%%|*}"); labels+=("${pair#*|}"); done
  local chosen=""
  if have gum; then
    chosen="$(printf '%s\n' "${labels[@]}" | gum choose --header "$header   (esc cancels)" --height 18)"
  else
    local PS3="$header > " opt
    select opt in "${labels[@]}"; do chosen="$opt"; break; done
  fi
  [ -z "$chosen" ] && { echo ""; return; }
  local i
  for i in "${!labels[@]}"; do
    [ "${labels[$i]}" = "$chosen" ] && { echo "${keys[$i]}"; return; }
  done
  echo ""
}

ask() { # prompt, default -> prints answer
  local p="$1" d="${2:-}"
  if have gum; then gum input --prompt "$p " --value "$d"
  else local v; read -rp "$p [$d]: " v; echo "${v:-$d}"; fi
}

# ask_req: like ask but returns non-zero (aborts the action) on empty input
ask_req() {
  local v; v="$(ask "$1" "${2:-}")"
  [ -z "$v" ] && return 1
  printf '%s' "$v"
}

# ask_pw: hidden input for secrets (never echoed); non-zero on empty
ask_pw() {
  local p="$1" v
  if have gum; then v="$(gum input --password --prompt "$p ")"
  else read -rsp "$p " v; echo >&2; fi
  [ -z "$v" ] && return 1
  printf '%s' "$v"
}

# Validating prompts — loop until valid or cancelled (empty). Deliberately loose
# (field-realistic, not RFC-strict octet ranges — the operator can see the value).
ask_num() { # prompt default -> integer
  local p="$1" d="${2:-}" v
  while :; do
    v="$(ask "$p" "$d")" || return 1
    [ -z "$v" ] && return 1
    case "$v" in ''|*[!0-9]*) warn "Enter digits only." ;; *) printf '%s' "$v"; return 0 ;; esac
  done
}
ask_ip() { # prompt default -> IPv4 dotted quad
  local p="$1" d="${2:-}" v
  while :; do
    v="$(ask "$p" "$d")" || return 1
    [ -z "$v" ] && return 1
    case "$v" in
      *[!0-9.]*) warn "IPv4 only (a.b.c.d)." ;;
      *.*.*.*)   printf '%s' "$v"; return 0 ;;
      *)         warn "Not an IPv4 address." ;;
    esac
  done
}
ask_cidr() { # prompt default -> address/prefix
  local p="$1" d="${2:-}" v
  while :; do
    v="$(ask "$p" "$d")" || return 1
    [ -z "$v" ] && return 1
    case "$v" in
      */[0-9]|*/[0-9][0-9])
        case "${v%%/*}" in *[!0-9.]*) warn "Bad address." ;; *) printf '%s' "$v"; return 0 ;; esac ;;
      *) warn "Need address/prefix, e.g. 192.168.1.0/24." ;;
    esac
  done
}

pause() { echo; read -rp "↩ Enter to return to menu… " _; }

run() { clear; echo "\$ $*"; echo "------------------------------------------"; "$@"; pause; }
# (No runsh/bash -c wrapper by design: it invited command injection from prompt
# input. Use array-form `run`, or an inline clear/echo/cmd/pause block when a
# redirect or compound command is genuinely needed — never build a shell string.)

# spin <title> <cmd...>: show a gum spinner while cmd runs (its output is hidden),
# returning the command's exit code. Falls back to a plain status line without gum.
# Prime sudo (sudo -v) before wrapping a sudo command so the spinner can't hide a
# password prompt.
spin() {
  local title="$1"; shift
  if have gum; then gum spin --spinner dot --title "$title" -- "$@"
  else echo "… $title"; "$@"; fi
}

# page <cmd...>: run a BATCH command, capture its output, show inline if it fits
# the screen else page it. Captures stdout+stderr — NEVER use on an interactive /
# streaming TUI (capturing would corrupt it). Retains output for save_last_report.
NETKIT_LAST_OUTPUT=""
page() {
  clear; printf '$ %s\n%s\n' "$*" "------------------------------------------"
  # Prime sudo first so a password prompt shows on the tty rather than being
  # swallowed by the 2>&1 capture below (which would look like a hang).
  [ "$1" = sudo ] && sudo -v 2>/dev/null
  local out rc rows
  out="$("$@" 2>&1)"; rc=$?
  NETKIT_LAST_OUTPUT="$out"
  rows="$(tput lines 2>/dev/null || echo 24)"
  if [ "$(printf '%s\n' "$out" | wc -l)" -le "$((rows - 4))" ]; then
    printf '%s\n' "$out"; pause
  elif have gum; then
    printf '%s\n' "$out" | gum pager
  else
    printf '%s\n' "$out" | less -R
  fi
  return "$rc"
}

say()  { printf '\n%s▶ %s%s\n' "$C_HDR"  "$*" "$C_RST"; }
ok()   { printf '  %s✓%s %s\n'  "$C_OK"   "$C_RST" "$*"; }
warn() { printf '  %s!%s %s\n'  "$C_WARN" "$C_RST" "$*"; }
bad()  { printf '  %s✗%s %s\n'  "$C_ERR"  "$C_RST" "$*"; }

need_iface() {
  [ -n "$IFACE" ] && return 0
  clear; echo "No usable network interface detected."; pause; return 1
}

# ---------- site profiles ----------
# Safe key=value parser (NOT sourced — config never executes as code).
NETKIT_SITE=""
SITE_SMTP=""; SITE_SMTP_PORT=""; SITE_SNMP_COMMUNITY=""; SITE_MQTT=""
SITE_SPEED_MIN=""; SITE_DNS_DOMAIN=""; SITE_HTTP_URL=""; SITE_PEER=""; SITE_LOGO=""

# ---------- device control (RS232 / IP) ----------
device_dir="$NETKIT_CFG_DIR/devices"
DEV_TRANSPORT=""; DEV_DEV=""; DEV_BAUD=""; DEV_FRAMING=""
DEV_HOST=""; DEV_PORT=""; DEV_READ_TIMEOUT=""; DEV_EOL=""; DEV_FORMAT=""
DEV_CMD_LABEL=(); DEV_CMD_FMT=(); DEV_CMD_PAYLOAD=(); DEV_CMD_EOL=()

load_site() {
  NETKIT_SITE=""
  SITE_SMTP=""; SITE_SMTP_PORT=""; SITE_SNMP_COMMUNITY=""; SITE_MQTT=""
  SITE_SPEED_MIN=""; SITE_DNS_DOMAIN=""; SITE_HTTP_URL=""; SITE_PEER=""; SITE_LOGO=""
  local af="$NETKIT_CFG_DIR/active-site"
  [ -f "$af" ] && NETKIT_SITE="$(cat "$af" 2>/dev/null)"
  [ -z "$NETKIT_SITE" ] && return 0
  local cf="$site_dir/$NETKIT_SITE.conf"
  [ -f "$cf" ] || { NETKIT_SITE=""; return 0; }
  local line key val
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"; key="${key// /}"
    case "$key" in
      SMTP) SITE_SMTP="$val" ;;
      SMTP_PORT) SITE_SMTP_PORT="$val" ;;
      SNMP_COMMUNITY) SITE_SNMP_COMMUNITY="$val" ;;
      MQTT) SITE_MQTT="$val" ;;
      SPEED_MIN) SITE_SPEED_MIN="$val" ;;
      DNS_DOMAIN) SITE_DNS_DOMAIN="$val" ;;
      HTTP_URL) SITE_HTTP_URL="$val" ;;
      PEER) SITE_PEER="$val" ;;
      LOGO) SITE_LOGO="$val" ;;
      *) : ;;
    esac
  done < "$cf"
}

site_list() { find "$site_dir" -maxdepth 1 -name '*.conf' -printf '%f\n' 2>/dev/null | sed 's/\.conf$//'; }

site_show() {
  echo "Active site: ${NETKIT_SITE:-<none>}"
  [ -n "$NETKIT_SITE" ] && { echo; cat "$site_dir/$NETKIT_SITE.conf" 2>/dev/null; }
}

site_new() {
  local name smtp port comm mqtt spd dom url peer logo
  name="$(ask_req 'Site name (no spaces):' '')" || return
  name="${name// /-}"
  smtp="$(ask 'SMTP relay (blank ok):' '')"
  port="$(ask 'SMTP port:' '587')"
  comm="$(ask 'SNMP community:' 'public')"
  mqtt="$(ask 'MQTT broker (blank ok):' '')"
  spd="$(ask 'Min Mbps for PASS:' '900')"
  dom="$(ask 'Default DNS domain (blank ok):' '')"
  url="$(ask 'Default HTTP URL (blank ok):' '')"
  peer="$(ask 'Peer IP for multicast (blank ok):' '')"
  logo="$(ask 'Report logo path (blank ok):' '')"
  mkdir -p "$site_dir"
  local f="$site_dir/$name.conf"
  {
    echo "# netkit site profile: $name"
    echo "SMTP=$smtp"; echo "SMTP_PORT=$port"; echo "SNMP_COMMUNITY=$comm"
    echo "MQTT=$mqtt"; echo "SPEED_MIN=$spd"; echo "DNS_DOMAIN=$dom"
    echo "HTTP_URL=$url"; echo "PEER=$peer"; echo "LOGO=$logo"
  } > "$f"
  echo "$name" > "$NETKIT_CFG_DIR/active-site"
  load_site
  clear; echo "Created and activated: $name"; echo; cat "$f"; pause
}

site_select() {
  local names n pairs=()
  names="$(site_list)"
  [ -z "$names" ] && { clear; echo "No sites yet — create one with: netkit site new"; pause; return; }
  while IFS= read -r n; do [ -n "$n" ] && pairs+=("$n|$n"); done <<< "$names"
  pairs+=("__none|‹ clear active site")
  local sel; sel="$(menu "Select site" "${pairs[@]}")"
  [ -z "$sel" ] && return
  if [ "$sel" = "__none" ]; then rm -f "$NETKIT_CFG_DIR/active-site"
  else echo "$sel" > "$NETKIT_CFG_DIR/active-site"; fi
  load_site
}

m_site() {
  local k; k="$(menu "🏷 Site — ${NETKIT_SITE:-none}" \
    "select|Select active site" \
    "new|Create new site profile" \
    "show|Show active site" \
    "clear|Clear active site" \
    "back|‹ back")"
  case "$k" in
    select) site_select ;;
    new) site_new ;;
    show) clear; site_show; pause ;;
    clear) rm -f "$NETKIT_CFG_DIR/active-site"; load_site; clear; echo "Cleared active site."; pause ;;
    *) return ;;
  esac
}

# CLI: netkit site [new|show|<name>]
do_site() {
  case "${1:-}" in
    new) site_new ;;
    show|"") load_site; site_show ;;
    *) if [ -f "$site_dir/$1.conf" ]; then echo "$1" > "$NETKIT_CFG_DIR/active-site"; echo "Active site: $1"
       else echo "No such site: $1 (create with: netkit site new)"; fi ;;
  esac
}

# ---------- per-site dated output folder ----------
report_dir() {
  local d
  d="$HOME/netkit-reports/${NETKIT_SITE:-default}/$(date +%Y%m%d)"
  mkdir -p "$d"
  printf '%s' "$d"
}

# ---------- battery (optional UPS/HAT via sysfs) ----------
battery_status() {
  local b
  for b in /sys/class/power_supply/*; do
    [ -e "$b/type" ] || continue
    if [ "$(cat "$b/type" 2>/dev/null)" = "Battery" ] && [ -r "$b/capacity" ]; then
      local cap; cap="$(cat "$b/capacity" 2>/dev/null)"
      [ -n "$cap" ] && { printf '%s' "$cap"; return 0; }
    fi
  done
  return 1
}

# Gateway reachability dot, cached 15s so menu redraws don't pay a ~1s ping each.
GW_REACH=""; GW_REACH_TS="0"
gw_dot() {
  local now; now="$(date +%s)"
  if [ "$((now - GW_REACH_TS))" -ge 15 ]; then
    if [ -n "$GW" ] && ping -c1 -W1 "$GW" >/dev/null 2>&1; then GW_REACH="up"; else GW_REACH="down"; fi
    GW_REACH_TS="$now"
  fi
  case "$GW_REACH" in
    up)   printf '%s●%s' "$C_OK"  "$C_RST" ;;
    down) printf '%s●%s' "$C_ERR" "$C_RST" ;;
    *)    printf '○' ;;
  esac
}

status_line() {
  local dot s
  dot="$(gw_dot)"
  s=" iface: ${IFACE:-?}  ip: ${SELFIP:-?}  gw: $dot ${GW:-?}  wifi: ${WIFACE:-none}"
  [ -n "$NETKIT_SITE" ] && s="$s  site: $NETKIT_SITE"
  local b; if b="$(battery_status)"; then s="$s  bat: ${b}%"; fi
  printf '%s\n' "$s"
}

# ---------- live network facts ----------
IFACE="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{print $2; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip -o link show up 2>/dev/null | awk -F': ' '$2!="lo"{print $2; exit}')"

GW="$(ip route show default 2>/dev/null | awk '{print $3; exit}')"
CIDR="$(ip -o -f inet addr show "${IFACE:-lo}" 2>/dev/null | awk '{print $4; exit}')"
SELFIP="${CIDR%%/*}"

WIFACE="$(for d in /sys/class/net/*/wireless; do
  [ -e "$d" ] && basename "$(dirname "$d")" && break; done)"

WIRED="$(for d in /sys/class/net/*; do
  n="$(basename "$d")"; [ "$n" = "lo" ] && continue
  [ -e "$d/wireless" ] && continue
  [ -e "$d/device" ] && { echo "$n"; break; }
done)"

# ---------- device-control helpers ----------
# framing_socat 8N1 -> "cs8,parenb=0,cstopb=0"  (rc 1 on bad framing)
framing_socat() {
  local f="$1" bits par stop out
  case "$f" in [78][NEOneo][12]) ;; *) return 1 ;; esac
  bits="${f:0:1}"; par="${f:1:1}"; stop="${f:2:1}"
  out="cs$bits"
  case "$par" in
    N|n) out="$out,parenb=0" ;;
    E|e) out="$out,parenb=1,parodd=0" ;;
    O|o) out="$out,parenb=1,parodd=1" ;;
    *)   return 1 ;;
  esac
  case "$stop" in 1) out="$out,cstopb=0" ;; 2) out="$out,cstopb=1" ;; esac
  printf '%s' "$out"
}

# framing_tio 8N1 -> "-d 8 -p none -s 1"  (rc 1 on bad framing)
framing_tio() {
  local f="$1" bits par stop p
  case "$f" in [78][NEOneo][12]) ;; *) return 1 ;; esac
  bits="${f:0:1}"; par="${f:1:1}"; stop="${f:2:1}"
  case "$par" in N|n) p=none ;; E|e) p=even ;; O|o) p=odd ;; *) return 1 ;; esac
  printf '%s' "-d $bits -p $p -s $stop"
}

# hex_norm string -> bare hex digits. Strips whitespace and a 0x/0X prefix on each
# whitespace-delimited token (anchored so it can't corrupt hex mid-token, e.g. 'a0xb').
# Shared by devctl_valid_hex and devctl_emit so validation and emission strip identically.
hex_norm() { printf '%s' "$1" | sed -E 's/(^|[[:space:]])0[xX]/\1/g' | tr -d '[:space:]'; }

# devctl_emit format payload eol -> raw bytes on STDOUT (streamed; NUL-safe).
# ascii uses %s (no accidental escape expansion); hex uses xxd -r -p (emits 0x00 too).
devctl_emit() {
  case "$1" in
    ascii) printf '%s' "$2" ;;
    hex)   hex_norm "$2" | xxd -r -p ;;
  esac
  case "$3" in cr) printf '\r' ;; lf) printf '\n' ;; crlf) printf '\r\n' ;; esac
}

# devctl_valid_hex string -> rc 0 if even-length hex (whitespace / per-token 0x allowed)
devctl_valid_hex() {
  local h; h="$(hex_norm "$1")"
  [ -n "$h" ] || return 1
  case "$h" in *[!0-9A-Fa-f]*) return 1 ;; esac
  [ $(( ${#h} % 2 )) -eq 0 ]
}

# load_device name -> rc 0 and populate DEV_* + DEV_CMD_* arrays; rc 1 if no file.
# Whitelist line parser — the .conf is NEVER sourced (security boundary, like load_site).
load_device() {
  DEV_TRANSPORT=""; DEV_DEV=""; DEV_BAUD=""; DEV_FRAMING=""
  DEV_HOST=""; DEV_PORT=""; DEV_READ_TIMEOUT=""; DEV_EOL=""; DEV_FORMAT=""
  DEV_CMD_LABEL=(); DEV_CMD_FMT=(); DEV_CMD_PAYLOAD=(); DEV_CMD_EOL=()
  local cf="$device_dir/$1.conf"
  [ -f "$cf" ] || return 1
  local line key val l f p e
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue ;; esac
    key="${line%%=*}"; val="${line#*=}"; key="${key// /}"
    case "$key" in
      TRANSPORT) DEV_TRANSPORT="$val" ;;
      DEV) DEV_DEV="$val" ;;
      BAUD) DEV_BAUD="$val" ;;
      FRAMING) DEV_FRAMING="$val" ;;
      HOST) DEV_HOST="$val" ;;
      PORT) DEV_PORT="$val" ;;
      READ_TIMEOUT) DEV_READ_TIMEOUT="$val" ;;
      EOL) DEV_EOL="$val" ;;
      FORMAT) DEV_FORMAT="$val" ;;
      CMD) IFS='|' read -r l f p e <<< "$val"
           DEV_CMD_LABEL+=("$l"); DEV_CMD_FMT+=("$f")
           DEV_CMD_PAYLOAD+=("$p"); DEV_CMD_EOL+=("$e") ;;
      *) : ;;
    esac
  done < "$cf"
}

device_list() { find "$device_dir" -maxdepth 1 -name '*.conf' -printf '%f\n' 2>/dev/null | sed 's/\.conf$//'; }
device_show_file() { cat "$device_dir/$1.conf" 2>/dev/null; }

# devctl_addr transport a b [c] -> socat address.  serial: dev baud framing | ip: host port.
# All serial boolean options are explicit (=0/=1): bare names only ENABLE, leaving the
# disabled case in an undefined prior state. 'rawer' (not obsolete 'raw').
devctl_addr() {
  case "$1" in
    serial) local fr; fr="$(framing_socat "$4")" || return 1
            printf '%s,b%s,rawer,echo=0,clocal=1,%s,crtscts=0' "$2" "$3" "$fr" ;;
    tcp)    printf 'TCP:%s:%s' "$2" "$3" ;;
    udp)    printf 'UDP:%s:%s' "$2" "$3" ;;
    *)      return 1 ;;
  esac
}

# devctl_pipe fmt payload eol timeout addr  — streamed emit|socat; run UNDER page (ascii reply).
# -T<N> = inactivity/read timeout (send, then read reply up to N s, exit). -t0 = drain on EOF.
devctl_pipe() {
  devctl_emit "$1" "$2" "$3" | socat -T"$4" -t0 - "$5"
}

# devctl_send transport addr fmt payload eol timeout
# ascii -> page (text reply, capture-safe). hex -> tmpfile + xxd (binary reply, NUL-safe).
devctl_send() {
  local fmt="$3" payload="$4" eol="$5" to="${6:-2}" addr="$2"
  if [ "$fmt" = hex ]; then
    require xxd xxd || return
    if ! devctl_valid_hex "$payload"; then
      clear; echo "Command has invalid hex (uneven/garbage) — edit or re-add it."; pause; return
    fi
    local tmpf; tmpf="$(mktemp)"
    devctl_emit "$fmt" "$payload" "$eol" | socat -T"$to" -t0 - "$addr" >"$tmpf" 2>/dev/null
    if [ -s "$tmpf" ]; then page xxd "$tmpf"
    else clear; echo "No reply bytes (device may be write-only, or check wiring/addr)."; pause; fi
    rm -f "$tmpf"
  else
    page devctl_pipe "$fmt" "$payload" "$eol" "$to" "$addr"
  fi
}

# devctl_live transport a b [c]  — interactive session (owns terminal -> run, never page).
devctl_live() {
  case "$1" in
    serial) require tio tio || return
            [ -e "$2" ] || { clear; echo "No such device: $2"; pause; return; }
            local fargs; fargs="$(framing_tio "$4")" || { clear; echo "Bad framing: $4"; pause; return; }
            local ta; read -ra ta <<< "$fargs"
            run tio -b "$3" "${ta[@]}" -f none "$2" ;;   # device LAST per tio synopsis
    tcp)    require ncat ncat || return; run ncat "$2" "$3" ;;
    udp)    require ncat ncat || return; run ncat -u "$2" "$3" ;;
  esac
}

device_new() {
  local name tr dev baud fr host port to eol fmt
  name="$(ask_req 'Device name (no spaces):' '')" || return
  name="${name// /-}"
  tr="$(menu 'Transport' 'serial|Serial (RS232)' 'tcp|TCP' 'udp|UDP')"; [ -z "$tr" ] && return
  if [ "$tr" = serial ]; then
    dev="$(ask 'Serial device:' '/dev/ttyUSB0')"
    baud="$(ask_num 'Baud:' '9600')" || return
    fr="$(ask 'Framing (8N1/8E1/7E1…):' '8N1')"
  else
    host="$(ask_ip 'Host IP:' "$GW")" || return
    port="$(ask_num 'Port:' '4998')" || return
  fi
  to="$(ask_num 'Read timeout (s):' '2')" || return
  eol="$(menu 'Default line ending' 'cr|CR' 'lf|LF' 'crlf|CRLF' 'none|none')"; [ -z "$eol" ] && eol=cr
  fmt="$(menu 'Default command format' 'ascii|ASCII text' 'hex|Hex bytes')"; [ -z "$fmt" ] && fmt=ascii
  mkdir -p "$device_dir"
  local f="$device_dir/$name.conf"
  {
    echo "# netkit device profile: $name"
    echo "TRANSPORT=$tr"
    echo "DEV=${dev:-}"; echo "BAUD=${baud:-}"; echo "FRAMING=${fr:-}"
    echo "HOST=${host:-}"; echo "PORT=${port:-}"
    echo "READ_TIMEOUT=$to"; echo "EOL=$eol"; echo "FORMAT=$fmt"
  } > "$f"
  clear; echo "Created device: $name"; echo; cat "$f"; pause
}

device_add_cmd() { # name
  local name="$1" label fmt payload eol
  label="$(ask_req 'Command label:' '')" || return
  case "$label" in *'|'*) clear; echo "Label cannot contain '|'."; pause; return ;; esac
  fmt="$(menu 'Format' 'ascii|ASCII text' 'hex|Hex bytes')"; [ -z "$fmt" ] && fmt="${DEV_FORMAT:-ascii}"
  payload="$(ask_req 'Payload:' '')" || return
  case "$payload" in *'|'*) clear; echo "Payload cannot contain '|'."; pause; return ;; esac
  if [ "$fmt" = hex ] && ! devctl_valid_hex "$payload"; then
    clear; echo "Invalid hex (need an even count of hex digits)."; pause; return
  fi
  eol="$(menu 'Line ending' 'cr|CR' 'lf|LF' 'crlf|CRLF' 'none|none')"; [ -z "$eol" ] && eol="${DEV_EOL:-none}"
  printf 'CMD=%s|%s|%s|%s\n' "$label" "$fmt" "$payload" "$eol" >> "$device_dir/$name.conf"
  clear; echo "Added command: $label"; pause
}

device_del_cmd() { # name
  local name="$1"; load_device "$name" || { clear; echo "No such device."; pause; return; }
  [ "${#DEV_CMD_LABEL[@]}" -gt 0 ] || { clear; echo "No commands to remove."; pause; return; }
  local pairs=() i
  for i in "${!DEV_CMD_LABEL[@]}"; do pairs+=("$i|${DEV_CMD_LABEL[$i]}"); done
  local sel; sel="$(menu 'Remove which command?' "${pairs[@]}")"; [ -z "$sel" ] && return
  local f="$device_dir/$name.conf" tmpf; tmpf="$(mktemp)"
  grep -v '^CMD=' "$f" > "$tmpf"
  for i in "${!DEV_CMD_LABEL[@]}"; do
    [ "$i" = "$sel" ] && continue
    printf 'CMD=%s|%s|%s|%s\n' "${DEV_CMD_LABEL[$i]}" "${DEV_CMD_FMT[$i]}" \
      "${DEV_CMD_PAYLOAD[$i]}" "${DEV_CMD_EOL[$i]}" >> "$tmpf"
  done
  mv "$tmpf" "$f"
  clear; echo "Removed."; pause
}

device_delete() { # name
  local a; a="$(ask "Delete device '$1'? (y/N):" "N")"
  case "$a" in y|Y|yes|YES) rm -f "$device_dir/$1.conf"; clear; echo "Deleted $1."; pause ;;
               *) clear; echo "Cancelled."; pause ;; esac
}

# PJLink class-1 probe (TCP 4352). On connect the projector emits a greeting line
# ("PJLINK 0" no-auth | "PJLINK 1 <nonce>" auth) BEFORE accepting a command — it must
# be skipped, else it's mistaken for the response. v1 = unauthenticated projectors only.
pjlink_probe() {
  require socat socat || return
  local host; host="$(ask_ip 'Projector IP:' "$GW")" || return
  local q raw line out="" first=1
  for q in POWR INPT AVMT LAMP NAME INF1 CLSS; do
    # One connection per query (conservative: works whether or not the projector keeps
    # the session open). The greeting line ("PJLINK 0|1 …") precedes the reply on every
    # connection. PJLink terminates lines with CR, so translate CR->LF before grep.
    raw="$({ sleep 0.2; printf '%%1%s ?\r' "$q"; } | socat -T2 -t0 - TCP:"$host":4352 2>/dev/null)"
    if [ "$first" = 1 ]; then
      first=0
      [ -z "$raw" ] && { clear; echo "No response from $host:4352 (not a PJLink device, or unreachable)."; pause; return; }
      case "$raw" in
        *"PJLINK 1"*) clear; echo "Projector requires PJLink authentication — not supported in v1."; pause; return ;;
      esac
    fi
    line="$(printf '%s\n' "$raw" | tr '\r' '\n' | grep '^%1' | head -n1)"
    out="$out$(printf '%-5s %s' "$q" "${line:-<no reply>}")"$'\n'
  done
  NETKIT_LAST_OUTPUT="$out"
  clear
  printf 'PJLink probe — %s (TCP 4352)\n------------------------------------------\n%s' "$host" "$out"
  pause
}

devctl_send_adhoc() {
  require socat socat || return
  local tr; tr="$(menu 'Transport' 'serial|Serial' 'tcp|TCP' 'udp|UDP')"; [ -z "$tr" ] && return
  local addr fmt payload eol to dev baud fr host port
  if [ "$tr" = serial ]; then
    dev="$(ask 'Serial device:' '/dev/ttyUSB0')"
    [ -e "$dev" ] || { clear; echo "No such device: $dev"; pause; return; }
    baud="$(ask_num 'Baud:' '9600')" || return
    fr="$(ask 'Framing:' '8N1')"
    addr="$(devctl_addr serial "$dev" "$baud" "$fr")" || { clear; echo "Bad framing: $fr"; pause; return; }
  else
    host="$(ask_ip 'Host:' "$GW")" || return
    port="$(ask_num 'Port:' '4998')" || return
    addr="$(devctl_addr "$tr" "$host" "$port")"
  fi
  fmt="$(menu 'Format' 'ascii|ASCII text' 'hex|Hex bytes')"; [ -z "$fmt" ] && return
  payload="$(ask_req 'Command:' '')" || return
  if [ "$fmt" = hex ] && ! devctl_valid_hex "$payload"; then clear; echo "Invalid hex."; pause; return; fi
  eol="$(menu 'Line ending' 'cr|CR' 'lf|LF' 'crlf|CRLF' 'none|none')"; [ -z "$eol" ] && eol=none
  to="$(ask_num 'Read timeout (s):' '2')" || return
  devctl_send "$tr" "$addr" "$fmt" "$payload" "$eol" "$to"
}

devctl_live_adhoc() {
  local tr; tr="$(menu 'Transport' 'serial|Serial' 'tcp|TCP' 'udp|UDP')"; [ -z "$tr" ] && return
  local dev baud fr host port
  if [ "$tr" = serial ]; then
    dev="$(ask 'Serial device:' '/dev/ttyUSB0')"
    [ -e "$dev" ] || { clear; echo "No such device: $dev"; pause; return; }
    baud="$(ask_num 'Baud:' '9600')" || return
    fr="$(ask 'Framing:' '8N1')"
    devctl_live serial "$dev" "$baud" "$fr"
  else
    host="$(ask_ip 'Host:' "$GW")" || return
    port="$(ask_num 'Port:' '4998')" || return
    devctl_live "$tr" "$host" "$port"
  fi
}

device_fire() { # name; DEV_* already loaded by caller
  [ "${#DEV_CMD_LABEL[@]}" -gt 0 ] || { clear; echo "No commands yet — add one first."; pause; return; }
  local pairs=() i; for i in "${!DEV_CMD_LABEL[@]}"; do pairs+=("$i|${DEV_CMD_LABEL[$i]}"); done
  local sel; sel="$(menu 'Send which command?' "${pairs[@]}")"; [ -z "$sel" ] && return
  local addr to="${DEV_READ_TIMEOUT:-2}"
  if [ "$DEV_TRANSPORT" = serial ]; then
    [ -e "$DEV_DEV" ] || { clear; echo "No such device: $DEV_DEV"; pause; return; }
    addr="$(devctl_addr serial "$DEV_DEV" "$DEV_BAUD" "$DEV_FRAMING")" || { clear; echo "Bad framing."; pause; return; }
  else
    addr="$(devctl_addr "$DEV_TRANSPORT" "$DEV_HOST" "$DEV_PORT")"
  fi
  require socat socat || return
  devctl_send "$DEV_TRANSPORT" "$addr" "${DEV_CMD_FMT[$sel]}" "${DEV_CMD_PAYLOAD[$sel]}" "${DEV_CMD_EOL[$sel]}" "$to"
}

device_actions() { # name
  load_device "$1" || { clear; echo "Could not load device $1."; pause; return; }
  while true; do
    local k; k="$(menu "🎛 $1 (${DEV_TRANSPORT:-?})" \
      "fire|Send a saved command" \
      "live|Live interactive session" \
      "add|Add a command" \
      "del|Remove a command" \
      "rm|Delete this device" \
      "show|Show profile" \
      "back|‹ back")"
    case "$k" in
      fire) device_fire "$1" ;;
      live) if [ "$DEV_TRANSPORT" = serial ]; then devctl_live serial "$DEV_DEV" "$DEV_BAUD" "$DEV_FRAMING"
            else devctl_live "$DEV_TRANSPORT" "$DEV_HOST" "$DEV_PORT"; fi ;;
      add) device_add_cmd "$1"; load_device "$1" ;;
      del) device_del_cmd "$1"; load_device "$1" ;;
      rm) device_delete "$1"; return ;;
      show) clear; device_show_file "$1"; pause ;;
      *) return ;;
    esac
  done
}

device_pick() {
  local names n pairs=()
  names="$(device_list)"
  [ -z "$names" ] && { clear; echo "No devices yet — use 'Create device profile'."; pause; return; }
  while IFS= read -r n; do [ -n "$n" ] && pairs+=("$n|$n"); done <<< "$names"
  local sel; sel="$(menu 'Select device' "${pairs[@]}")"; [ -z "$sel" ] && return
  device_actions "$sel"
}

m_devctl() {
  local k; k="$(menu '🎛 Device Control' \
    "send|Quick send (ad-hoc) → read reply" \
    "live|Live interactive session" \
    "dev|Saved devices (recall & fire)" \
    "newdev|Create device profile" \
    "pjlink|PJLink projector probe (TCP 4352)" \
    "back|‹ back")"
  case "$k" in
    send) devctl_send_adhoc ;;
    live) devctl_live_adhoc ;;
    dev) device_pick ;;
    newdev) device_new ;;
    pjlink) pjlink_probe ;;
    *) return ;;
  esac
}

# ---------- categories ----------
m_discovery() {
  local k; k="$(menu "🔍 Discovery" \
    "arp|ARP sweep (layer-2, fast)" \
    "fp|fping sweep (which IPs answer)" \
    "nsn|Nmap ping sweep (-sn)" \
    "nsv|Nmap service scan (-sV)" \
    "dhcp|DHCP servers (rogue check)" \
    "mdns|mDNS / Bonjour browse (all)" \
    "av|AV gear (Dante / NDI / AirPlay / Sonos)" \
    "n6|IPv6 (neighbours / routers)" \
    "back|‹ back")"
  case "$k" in
    arp) need_iface || return; run sudo arp-scan --interface="$IFACE" --localnet ;;
    fp)  local n; n="$(ask_cidr "Subnet:" "$CIDR")" || return
         require fping fping || return
         # Quoted arg, no bash -c; stderr (unreachable noise) suppressed inline.
         clear; printf '$ fping -a -g %s\n%s\n' "$n" "------------------------------------------"
         fping -a -g "$n" 2>/dev/null; pause ;;
    nsn) local n; n="$(ask_cidr "Subnet:" "$CIDR")" || return; page sudo nmap -sn "$n" ;;
    nsv) local h; h="$(ask_req "Host:" "$GW")" || return; page sudo nmap -sV -T4 --top-ports 200 "$h" ;;
    dhcp) need_iface || return; run sudo nmap --script broadcast-dhcp-discover -e "$IFACE" ;;
    mdns) run avahi-browse -a -t -r ;;
    av) run av_browse ;;
    n6) m_ipv6 ;;
    *) return ;;
  esac
}

av_browse() {
  if ! have avahi-browse; then echo "avahi-browse missing (apt install avahi-utils)"; return; fi
  local types=(
    _netaudio-arc._udp _netaudio-cmc._udp _netaudio-chan._udp
    _ndi._tcp _airplay._tcp _raop._tcp _googlecast._tcp _sonos._tcp _spotify-connect._tcp
  )
  local ty hit=0
  for ty in "${types[@]}"; do
    local out
    out="$(avahi-browse -t -r -p "$ty" 2>/dev/null \
            | awk -F';' '/^=/{printf "    %-28s %s:%s  (%s)\n", $4, $8, $9, $7}')"
    if [ -n "$out" ]; then printf '  %s\n%s\n' "$ty" "$out"; hit=1; fi
  done
  [ "$hit" -eq 0 ] && echo "  No AV/mDNS services seen on this network."
}

m_ipv6() {
  need_iface || return
  local k; k="$(menu "🌐 IPv6 ($IFACE)" \
    "nbr|Neighbour sweep (link-local all-nodes)" \
    "rtr|Router discovery (rdisc6)" \
    "lookup|Neighbour lookup (ndisc6 <addr>)" \
    "back|‹ back")"
  case "$k" in
    nbr) # Quoted args, no bash -c: prime the neighbour cache, then show it.
         clear; printf '$ ip -6 neigh show dev %s   (after multicast ping)\n%s\n' "$IFACE" "------------------------------------------"
         ping -6 -c2 "ff02::1%$IFACE" >/dev/null 2>&1
         ip -6 neigh show dev "$IFACE"; pause ;;
    rtr) require rdisc6 ndisc6 || return; run rdisc6 "$IFACE" ;;
    lookup) require ndisc6 ndisc6 || return
            local a; a="$(ask_req "IPv6 address:" "")" || return; run ndisc6 "$a" "$IFACE" ;;
    *) return ;;
  esac
}

m_link() {
  local k; k="$(menu "🔗 Link & Throughput" \
    "isrv|iperf3 — run as SERVER (listen)" \
    "icli|iperf3 — run as CLIENT (test to server)" \
    "icli2|iperf3 client + PASS/FAIL (vs threshold)" \
    "wan|WAN speed test (to the internet)" \
    "mtr|mtr (latency + loss to host)" \
    "ping|ping graph" \
    "back|‹ back")"
  case "$k" in
    isrv) run iperf3 -s ;;
    icli) local s; s="$(ask_req "Server IP:" "$GW")" || return; run iperf3 -c "$s" ;;
    icli2) iperf_passfail ;;
    wan)  require librespeed-cli librespeed-cli || return; run librespeed-cli --no-icmp ;;
    mtr) local h; h="$(ask_req "Host:" "1.1.1.1")" || return; run mtr "$h" ;;
    ping) local h; h="$(ask_req "Host:" "$GW")" || return
          if have gping; then run gping "$h"; else run ping "$h"; fi ;;
    *) return ;;
  esac
}

iperf_passfail() {
  local s thr bps mbps
  s="$(ask_req "Server IP:" "$GW")" || return
  thr="$(ask_num "Min Mbps for PASS:" "${SITE_SPEED_MIN:-900}")" || return
  clear; echo "\$ iperf3 -c $s   (judging against ${thr} Mbps)"
  echo "------------------------------------------"
  bps="$(iperf3 -c "$s" -J 2>/dev/null | jq -r '.end.sum_received.bits_per_second // empty')"
  if [ -n "$bps" ]; then
    mbps="$(awk -v b="$bps" 'BEGIN{printf "%.0f", b/1000000}')"
    if [ "$mbps" -ge "$thr" ] 2>/dev/null; then
      printf 'RESULT: %s Mbps  →  %sPASS%s  (≥ %s)\n' "$mbps" "$C_OK"  "$C_RST" "$thr"
    else
      printf 'RESULT: %s Mbps  →  %sFAIL%s  (< %s)\n' "$mbps" "$C_ERR" "$C_RST" "$thr"
    fi
  else
    echo "iperf3 test failed — is a server running on $s:5201?"
  fi
  pause
}

m_wifi() {
  if [ -z "$WIFACE" ]; then
    clear; echo "No wireless interface found on this unit."; pause; return
  fi
  local k; k="$(menu "📡 WiFi ($WIFACE)" \
    "wm|wavemon (live signal/noise)" \
    "nm|Scan nearby APs (nmcli)" \
    "iw|Scan nearby APs (iw)" \
    "back|‹ back")"
  case "$k" in
    wm) run wavemon -i "$WIFACE" ;;
    nm) run nmcli -f IN-USE,SSID,CHAN,SIGNAL,SECURITY device wifi list ;;
    iw) run sudo iw dev "$WIFACE" scan ;;
    *) return ;;
  esac
}

m_packet() {
  need_iface || return
  local k; k="$(menu "🧰 Packet Inspection ($IFACE)" \
    "ts|termshark (TUI Wireshark, live)" \
    "td|tcpdump (quick capture)" \
    "iftop|iftop (per-connection bandwidth)" \
    "bw|bandwhich (per-process bandwidth)" \
    "back|‹ back")"
  case "$k" in
    ts) local f; f="$(ask "Capture filter (blank = all):" "")"
        if [ -n "$f" ]; then run termshark -i "$IFACE" -f "$f"; else run termshark -i "$IFACE"; fi ;;
    td) local f; f="$(ask "Filter (e.g. 'port 53'):" "")"
        # Pass the filter as a SINGLE argument (never via bash -c) so shell
        # metacharacters in it cannot execute. tcpdump takes the whole filter
        # expression as one arg.
        local tdargs=(sudo tcpdump -i "$IFACE" -n)
        [ -n "$f" ] && tdargs+=("$f")
        run "${tdargs[@]}" ;;
    iftop) run sudo iftop -i "$IFACE" ;;
    bw) require bandwhich bandwhich || return; run sudo bandwhich ;;
    *) return ;;
  esac
}

m_dns() {
  local k; k="$(menu "🌐 DNS / HTTP / Mail" \
    "dig|dig (lookup a record)" \
    "ptr|Reverse DNS (PTR)" \
    "http|HTTP headers check" \
    "port|Port open? (ncat)" \
    "smtp|SMTP reachability + capabilities (EHLO)" \
    "smtpsend|SMTP test send (device-alert check)" \
    "back|‹ back")"
  case "$k" in
    dig) local d ty; d="$(ask_req "Domain:" "${SITE_DNS_DOMAIN:-modalav.co.uk}")" || return
         ty="$(menu "Record type" "A|A" "AAAA|AAAA" "MX|MX" "TXT|TXT" "NS|NS" "CNAME|CNAME" "SOA|SOA")"
         [ -z "$ty" ] && return
         page dig +noall +answer "$d" "$ty" ;;
    ptr) local ip; ip="$(ask_ip "IP:" "$GW")" || return; run dig -x "$ip" +short ;;
    http) local u; u="$(ask_req "URL:" "${SITE_HTTP_URL:-https://modalav.co.uk}")" || return
          if have xh; then run xh -I "$u"; else run curl -sSIL "$u"; fi ;;
    port) local h p; h="$(ask_req "Host:" "$GW")" || return; p="$(ask_req "Port:" "443")" || return
          run ncat -zv "$h" "$p" ;;
    smtp) smtp_check ;;
    smtpsend) smtp_send ;;
    *) return ;;
  esac
}

smtp_check() {
  local h p; h="$(ask_req "SMTP server:" "${SITE_SMTP:-$GW}")" || return
  p="$(ask_req "Port:" "${SITE_SMTP_PORT:-587}")" || return
  if have swaks; then run swaks --server "$h:$p" --quit-after EHLO --timeout 10
  else page nmap -Pn -p "$p" --script smtp-commands "$h"; fi
}

smtp_send() {
  require swaks swaks || return
  local h p from to tlsmode auth user defport
  tlsmode="$(menu "Encryption" \
    "starttls|STARTTLS (submission, 587)" \
    "smtps|SMTPS / TLS-on-connect (465)" \
    "none|None / plaintext (25)")"
  [ -z "$tlsmode" ] && return
  defport="${SITE_SMTP_PORT:-587}"
  case "$tlsmode" in smtps) defport=465 ;; none) defport=25 ;; esac
  h="$(ask_req "SMTP server:" "${SITE_SMTP:-$GW}")" || return
  p="$(ask_req "Port:" "$defport")" || return
  from="$(ask_req "From:" "netkit@$(hostname -f 2>/dev/null || hostname)")" || return
  to="$(ask_req "To:" "")" || return
  local cmd=(swaks --server "$h:$p" --from "$from" --to "$to" --timeout 15)
  case "$tlsmode" in
    starttls) cmd+=(--tls) ;;
    smtps)    cmd+=(--tls-on-connect) ;;
  esac
  auth="$(ask "Use SMTP auth? (y/N):" "N")"
  case "$auth" in
    y|Y|yes|YES) user="$(ask_req "Auth username:" "")" || return
                 cmd+=(--auth --auth-user "$user" --auth-hide-password) ;;
  esac
  run "${cmd[@]}"
}

m_lldp() {
  local k; k="$(menu "🔌 Switch Port (LLDP / SNMP)" \
    "show|Show neighbours (which switch/port/VLAN)" \
    "watch|Watch neighbours (live)" \
    "snmp|Monitor a device via SNMP (ports, PoE, traffic…)" \
    "back|‹ back")"
  case "$k" in
    show) page sudo lldpcli show neighbors ;;
    watch) run sudo watch -n2 lldpcli show neighbors ;;
    snmp) m_snmp ;;
    *) return ;;
  esac
}

# ---------- SNMP device monitoring (v2c + v3) ----------
G_SNMP_ARGS=()

write_snmp_v3_conf() { # level user authproto authpass privproto privpass
  local lvl="$1" u="$2" ap="$3" apass="$4" pp="$5" ppass="$6"
  mkdir -p "$NETKIT_CFG_DIR"
  ( umask 077
    {
      echo "defVersion 3"
      echo "defSecurityLevel $lvl"
      echo "defSecurityName $u"
      echo "defAuthType $ap"
      echo "defAuthPassphrase $apass"
      if [ "$lvl" = "authPriv" ]; then
        echo "defPrivType $pp"
        echo "defPrivPassphrase $ppass"
      fi
    } > "$NETKIT_CFG_DIR/snmp.conf"
  )
  chmod 600 "$NETKIT_CFG_DIR/snmp.conf" 2>/dev/null || true
}

m_snmp() {
  require snmpwalk snmp || return
  local h ver
  h="$(ask_req "Device IP:" "$GW")" || return
  ver="$(menu "SNMP version" "v2c|v2c (community)" "v3|v3 (user + auth/priv)")"
  [ -z "$ver" ] && return
  if [ "$ver" = "v2c" ]; then
    local c; c="$(ask_req "Community:" "${SITE_SNMP_COMMUNITY:-public}")" || return
    G_SNMP_ARGS=(-v2c -c "$c" -t 2 -r 1)
    unset SNMPCONFPATH 2>/dev/null || true
  else
    local user al ap pl pp
    user="$(ask_req "v3 username:" "")" || return
    al="$(menu "Auth protocol" "SHA|SHA" "MD5|MD5")"; [ -z "$al" ] && return
    ap="$(ask_pw "Auth passphrase:")" || return
    pl="$(menu "Privacy protocol" "AES|AES" "DES|DES" "none|none (authNoPriv)")"; [ -z "$pl" ] && return
    if [ "$pl" = "none" ]; then
      write_snmp_v3_conf "authNoPriv" "$user" "$al" "$ap" "" ""
    else
      pp="$(ask_pw "Privacy passphrase:")" || return
      write_snmp_v3_conf "authPriv" "$user" "$al" "$ap" "$pl" "$pp"
    fi
    export SNMPCONFPATH="$NETKIT_CFG_DIR"
    G_SNMP_ARGS=(-v3 -t 2 -r 1)
  fi
  while true; do
    local k; k="$(menu "📟 SNMP — $h ($ver)" \
      "sys|System summary (model, name, uptime)" \
      "ports|Interfaces (status + speed)" \
      "rate|Port traffic — live bps (pick ifIndex)" \
      "poe|PoE status + power budget" \
      "walk|Walk an arbitrary OID" \
      "scan|Find SNMP devices on a subnet" \
      "back|‹ back")"
    case "$k" in
      sys)  page snmpwalk "${G_SNMP_ARGS[@]}" "$h" 1.3.6.1.2.1.1 ;;
      ports) page snmp_if_table "$h" ;;
      rate) snmp_rate "$h" ;;
      poe)  page snmp_poe "$h" ;;
      walk) local oid; oid="$(ask_req "OID:" "1.3.6.1.2.1.1")" || continue
            page snmpwalk "${G_SNMP_ARGS[@]}" "$h" "$oid" ;;
      scan) snmp_scan ;;
      *) return ;;
    esac
  done
}

snmp_if_table() {
  local h="$1"
  local -a SW=(snmpwalk "${G_SNMP_ARGS[@]}" -Oqn "$h")
  printf '%-6s %-26s %-8s %s\n' "idx" "interface" "status" "speed"
  {
    "${SW[@]}" 1.3.6.1.2.1.2.2.1.2; echo "---S---"
    "${SW[@]}" 1.3.6.1.2.1.2.2.1.8; echo "---S---"
    "${SW[@]}" 1.3.6.1.2.1.2.2.1.5
  } | awk '
    /---S---/ { sect++; next }
    { idx=$1; sub(/.*\./,"",idx); v=$2; for(i=3;i<=NF;i++) v=v" "$i
      if(sect==0) name[idx]=v; else if(sect==1) oper[idx]=v; else spd[idx]=v; seen[idx]=1 }
    END{ for(i in seen){
      s=oper[i]+0; st=(s==1?"up":s==2?"down":s==3?"testing":s==7?"lowerdn":"?")
      sp=spd[i]+0; if(sp>=1e9) hs=sprintf("%gG",sp/1e9); else if(sp>=1e6) hs=sprintf("%gM",sp/1e6); else hs=sp
      printf "%-6s %-26s %-8s %s\n", i, name[i], st, hs } }' | sort -n
}

snmp_poe() {
  local h="$1"
  local -a SW=(snmpwalk "${G_SNMP_ARGS[@]}" -Oqn "$h")
  echo "== Main PSE (watts — vendor scaling may vary) =="
  printf 'budget (pethMainPsePower):        '; "${SW[@]}" 1.3.6.1.2.1.105.1.3.1.1.2 2>/dev/null | awk '{print $2}' | paste -sd' ' -
  printf 'consumed (pethMainPseConsumption): '; "${SW[@]}" 1.3.6.1.2.1.105.1.3.1.1.4 2>/dev/null | awk '{print $2}' | paste -sd' ' -
  echo
  echo "== Per-port detection status =="
  local out
  out="$("${SW[@]}" 1.3.6.1.2.1.105.1.1.1.6 2>/dev/null | awk '
    { idx=$1; sub(/^.*\.105\.1\.1\.1\.6\./,"",idx); s=$2+0
      st=(s==1?"disabled":s==2?"searching":s==3?"DELIVERING":s==4?"fault":s==5?"test":s==6?"otherFault":"?")
      printf "  port %-8s %s\n", idx, st }')"
  if [ -n "$out" ]; then echo "$out"
  else echo "  (no POWER-ETHERNET-MIB data — not a PoE switch, or it uses a vendor MIB)"; fi
}

snmp_rate() {
  local h="$1" idx
  idx="$(ask_num "ifIndex (from the Interfaces list):" "")" || return
  run snmpdelta "${G_SNMP_ARGS[@]}" -Cs -CT "$h" \
    "1.3.6.1.2.1.31.1.1.1.6.$idx" "1.3.6.1.2.1.31.1.1.1.10.$idx"
}

snmp_scan() {
  local net comm
  net="$(ask_cidr "Subnet:" "$CIDR")" || return
  comm="$(ask_req "Community for probe:" "${SITE_SNMP_COMMUNITY:-public}")" || return
  page sudo nmap -sU -p161 --open --script snmp-info --script-args "snmp.community=$comm" "$net"
