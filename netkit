run_dash() {
  require tmux tmux || return
  need_iface || return
  local S="netkit-dash"
  tmux kill-session -t "$S" 2>/dev/null
  local pinger="ping ${GW:-1.1.1.1}"; have gping && pinger="gping ${GW:-1.1.1.1}"
  tmux new-session -d -s "$S" -n dash "watch -n2 'ip -br addr; echo; ip route'"
  tmux split-window -h -t "$S":0 "$pinger"
  tmux split-window -v -t "$S":0.0 "mtr ${GW:-1.1.1.1}"
  tmux split-window -v -t "$S":0.1 "vnstat -l -i $IFACE 2>/dev/null || watch -n2 'cat /proc/net/dev'"
  tmux select-layout -t "$S":0 tiled
  tmux attach -t "$S"
}

# ---------- prebuilt-binary registry (shared by setup + doctor) ----------
PREBUILT_REPOS=(librespeed/speedtest-cli orf/gping imsnif/bandwhich ducaale/xh jscott3201/rusty-bacnet)
PREBUILT_RX=(
  'linux_arm64\.tar\.gz$'
  '(aarch64|arm64).*linux.*tar\.gz$|linux.*(musl|gnu).*(aarch64|arm64).*tar\.gz$'
  'aarch64-unknown-linux-(musl|gnu).*tar\.gz$|aarch64.*linux.*tar\.gz$'
  'aarch64-unknown-linux-(musl|gnu).*tar\.gz$|aarch64.*linux.*tar\.gz$'
  'bacnet.*linux.*arm64$'
)
PREBUILT_BIN=(librespeed-cli gping bandwhich xh bacnet)
PREBUILT_NAME=('librespeed-cli (WAN speed test)' 'gping (ping graph)' 'bandwhich (per-process bw)' 'xh (modern curl)' 'bacnet (rusty-bacnet)')

install_release_bin() { # repo  asset_regex  binname  friendly
  local repo="$1" rx="$2" bin="$3" friendly="${4:-$3}" url tmp found
  if have "$bin"; then ok "$friendly already present"; return 0; fi
  url="$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
        | jq -r '.assets[].browser_download_url' 2>/dev/null \
        | grep -Ei "$rx" | head -n1)"
  if [ -z "$url" ]; then warn "$friendly: no matching aarch64 asset found — skipped"; return 1; fi
  tmp="$(mktemp -d)"
  if spin "$friendly: downloading…" curl -fsSL "$url" -o "$tmp/dl"; then
    case "$url" in
      *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp" 2>/dev/null ;;
      *.tar.xz)       tar -xJf "$tmp/dl" -C "$tmp" 2>/dev/null ;;
      *.zip)          unzip -q "$tmp/dl" -d "$tmp" 2>/dev/null ;;
      *)              cp "$tmp/dl" "$tmp/$bin" ;;
    esac
    found="$(find "$tmp" -type f -name "$bin" | head -n1)"
    if [ -n "$found" ]; then
      sudo install -m 0755 "$found" "$NETKIT_BIN_DIR/$bin" && ok "$friendly installed"
    else
      warn "$friendly: binary not found inside archive — skipped"
    fi
  else
    warn "$friendly: download failed — skipped"
  fi
  rm -rf "$tmp"
}

do_setup() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    echo "Run 'netkit setup' as your normal user (it calls sudo where needed)."; exit 1
  fi
  sudo -v 2>/dev/null || warn "sudo unavailable — apt steps may fail"
  say "Installing extra apt packages (MQTT, ethtool, SNMP, Bluetooth, RTL-SDR, mail, OT…)"
  local pkgs=(mosquitto-clients ethtool snmp fping ipcalc wakeonlan unzip
              bluez bluez-tools rtl-433 rtl-sdr swaks tio xxd
              mbpoll knxd-tools)
  spin "apt update…" sudo apt-get update -y || warn "apt update had issues"
  if spin "Installing apt extras…" sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}"; then
    ok "apt extras installed"
  else
    warn "Some apt packages failed — re-run: sudo apt-get install ${pkgs[*]}"
  fi

  say "Installing AV/IPv6 extras (best-effort; skipped if not in apt)"
  local p
  for p in linuxptp ndisc6; do
    if sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$p" >/dev/null 2>&1; then ok "$p"
    else warn "$p unavailable in apt — skipped"; fi
  done
  # omping (2-device multicast flow test) is not in Bookworm apt and ships only as
  # source (no arm64 binary), so netkit can't auto-install it under the no-compile
  # rule. The AV-over-IP menu still offers it if you install it yourself.
  have omping || echo "    omping (optional multicast flow test): not in apt — build from source if needed (github.com/troglobit/omping)"

  if getent group bluetooth >/dev/null 2>&1; then
    sudo usermod -aG bluetooth "$USER" 2>/dev/null \
      && ok "added $USER to 'bluetooth' group (log out/in to apply)"
  fi

  if getent group dialout >/dev/null 2>&1; then
    sudo usermod -aG dialout "$USER" 2>/dev/null \
      && ok "added $USER to 'dialout' group (serial port access)"
    echo "    (log out/in, or run 'newgrp dialout', for serial access to take effect)"
  fi

  say "Fetching prebuilt aarch64 binaries (GitHub latest releases)"
  local i
  for i in "${!PREBUILT_REPOS[@]}"; do
    install_release_bin "${PREBUILT_REPOS[$i]}" "${PREBUILT_RX[$i]}" "${PREBUILT_BIN[$i]}" "${PREBUILT_NAME[$i]}"
  done

  say "Setup complete"
  echo "Tip: run 'netkit selftest' to confirm, and 'netkit doctor' to pre-check binary matchers."
}

do_selftest() {
  clear; banner
  status_line
  echo
  say "Core tools"
  local t tools=(nmap arp-scan iperf3 mtr tcpdump dig lldpcli avahi-browse tmux gum)
  for t in "${tools[@]}"; do
    if have "$t"; then ok "$t"; else warn "$t MISSING"; fi
  done
  say "Optional extras"
  local x extras=(gping bandwhich xh librespeed-cli mosquitto_sub ethtool snmpwalk fping
                  ipcalc wakeonlan bluetoothctl btmon rtl_433 rtl_power swaks
                  ptp4l rdisc6 tio socat xxd
                  mbpoll knxtool bacnet)
  for x in "${extras[@]}"; do
    if have "$x"; then ok "$x"; else warn "$x missing (run: netkit setup)"; fi
  done
  # omping isn't in apt and has no arm64 binary — 'netkit setup' can't install it,
  # so report it honestly rather than hinting at a setup that won't help.
  if have omping; then ok "omping"; else warn "omping absent (optional; not in apt — build from source)"; fi
  # The OT scan/sweep actions need these NSE scripts; nmap being present isn't enough.
  # Standard Debian/RPi OS path — apt's nmap always ships them here.
  say "OT scan scripts (nmap NSE)"
  local ns
  for ns in modbus-discover bacnet-info s7-info enip-info; do
    if [ -f "/usr/share/nmap/scripts/$ns.nse" ]; then ok "$ns.nse"
    else warn "$ns.nse missing (Modbus/BACnet scan + ICS sweep need it)"; fi
  done
  say "Live checks"
  if [ -n "$GW" ] && ping -c1 -W2 "$GW" >/dev/null 2>&1; then ok "gateway $GW reachable"
  elif [ -n "$GW" ]; then warn "gateway $GW not answering ping"
  else warn "no default gateway"; fi
  if [ -n "$CIDR" ]; then
    local up; up="$(sudo nmap -sn "$CIDR" 2>/dev/null | grep -c 'Nmap scan report')"
    ok "nmap ping sweep $CIDR -> ${up:-0} host(s) up"
  fi
  echo
}

do_doctor() {
  echo "netkit doctor — checking prebuilt-binary release matchers against GitHub"
  echo
  local i url bp ftype
  for i in "${!PREBUILT_REPOS[@]}"; do
    url="$(curl -fsSL "https://api.github.com/repos/${PREBUILT_REPOS[$i]}/releases/latest" 2>/dev/null \
          | jq -r '.assets[].browser_download_url' 2>/dev/null \
          | grep -Ei "${PREBUILT_RX[$i]}" | head -n1)"
    if have "${PREBUILT_BIN[$i]}"; then
      # Show the binary's arch + linking so a wrong-arch download or a surprising
      # glibc-vs-static link (the rusty-bacnet caveat) is visible without running it.
      bp="$(command -v "${PREBUILT_BIN[$i]}")"; ftype=""
      have file && ftype="$(file -b "$bp" 2>/dev/null | cut -c1-46)"
      printf '  installed  %-13s %s\n' "${PREBUILT_BIN[$i]}" "${ftype:+($ftype)}"
    elif [ -n "$url" ]; then
      printf '  resolves   %-13s -> %s\n' "${PREBUILT_BIN[$i]}" "$(basename "$url")"
    else
      printf '  NO MATCH   %-13s (asset naming may have changed)\n' "${PREBUILT_BIN[$i]}"
    fi
  done
  echo
  echo "‘NO MATCH’ means the matcher needs updating; ‘resolves’ means setup would install it."
}

do_update() {
  local url="${1:-}"
  mkdir -p "$NETKIT_CFG_DIR"
  if [ -n "$url" ]; then printf '%s\n' "$url" > "$NETKIT_CFG_DIR/update.url"
  elif [ -f "$NETKIT_CFG_DIR/update.url" ]; then url="$(cat "$NETKIT_CFG_DIR/update.url")"; fi
  if [ -z "$url" ]; then
    echo "No update URL set. Pass the Raw gist URL once and it'll be remembered:"
    echo "  netkit update 'https://gist.githubusercontent.com/<user>/<id>/raw/netkit'"
    exit 1
  fi
  local tmp; tmp="$(mktemp)"
  if ! curl -fsSL "$url" -o "$tmp"; then echo "Download failed: $url"; rm -f "$tmp"; exit 1; fi
  if [ "$(head -1 "$tmp")" != "#!/usr/bin/env bash" ]; then
    echo "Refusing to install: fetched file isn't a bash script (got HTML?)."
    echo "Make sure you copied the *Raw* gist URL, not the gist web page."
    rm -f "$tmp"; exit 1
  fi
  if sudo install -m 0755 "$tmp" "$NETKIT_BIN"; then
    echo "Updated $NETKIT_BIN -> $(grep -m1 'NETKIT_VERSION=' "$NETKIT_BIN" | cut -d'"' -f2)"
  else
    echo "Install failed (need sudo rights to $NETKIT_BIN)."
  fi
  rm -f "$tmp"
}

do_uninstall() {
  echo "This removes $NETKIT_BIN only."
  echo "It leaves apt packages, ~/.config/netkit, and ~/netkit-reports in place."
  local a; a="$(ask "Remove netkit? (y/N):" "N")"
  case "$a" in
    y|Y|yes|YES) sudo rm -f "$NETKIT_BIN" && echo "Removed $NETKIT_BIN." ;;
    *) echo "Cancelled." ;;
  esac
}

# ---------- boot-to-netkit (explicit, reversible) ----------
do_autostart() {
  case "${1:-}" in
    on)
      echo "This will:"
      echo "  • enable console autologin for '$USER' on tty1 (systemd drop-in)"
      echo "  • launch netkit on tty1 login via a guarded ~/.bash_profile block"
      echo "It edits system config but is fully reversible: netkit autostart off"
      local a; a="$(ask "Proceed? (y/N):" "N")"
      case "$a" in y|Y|yes|YES) ;; *) echo "Cancelled."; return ;; esac
      sudo mkdir -p /etc/systemd/system/getty@tty1.service.d
      # shellcheck disable=SC2016  # $TERM must stay literal — systemd expands it at boot
      printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin %s --noclear %%I $TERM\n' "$USER" \
        | sudo tee /etc/systemd/system/getty@tty1.service.d/autologin.conf >/dev/null
      if ! grep -qF '# >>> netkit autostart >>>' "$HOME/.bash_profile" 2>/dev/null; then
        # If ~/.bash_profile doesn't exist yet, creating it would stop bash from
        # reading ~/.profile on login. Seed it to source ~/.profile first.
        if [ ! -f "$HOME/.bash_profile" ] && [ -f "$HOME/.profile" ]; then
          # shellcheck disable=SC2016  # literal — sourced at login, not now
          printf '%s\n' '[ -f "$HOME/.profile" ] && . "$HOME/.profile"' > "$HOME/.bash_profile"
        fi
        {
          echo '# >>> netkit autostart >>>'
          # shellcheck disable=SC2016  # must stay literal — evaluated at login, not now
          echo 'if [ "$(tty)" = "/dev/tty1" ] && [ -z "${SSH_TTY:-}" ]; then exec netkit; fi'
          echo '# <<< netkit autostart <<<'
        } >> "$HOME/.bash_profile"
      fi
      sudo systemctl daemon-reload
      echo "Autostart enabled. Reboot to test."
      ;;
    off)
      sudo rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
      sudo systemctl daemon-reload 2>/dev/null || true
      [ -f "$HOME/.bash_profile" ] && \
        sed -i '/# >>> netkit autostart >>>/,/# <<< netkit autostart <<</d' "$HOME/.bash_profile"
      echo "Autostart removed."
      ;;
    *) echo "Usage: netkit autostart on|off" ;;
  esac
}

usage() {
  cat <<EOF
netkit v${NETKIT_VERSION} — Pi 5 network toolkit
  netkit               interactive dashboard
  netkit dash          tiled live view (tmux)
  netkit report        markdown site snapshot
  netkit sweep         full commissioning sweep → branded report
  netkit setup         install/refresh extra deps
  netkit selftest      bench check
  netkit doctor        check prebuilt-binary matchers vs GitHub
  netkit site [name]   site profiles (prefill prompts per location)
  netkit autostart on|off   boot the unit straight into netkit
  netkit update [URL]  re-pull this script from a Raw gist URL
  netkit uninstall     remove the netkit binary
  netkit version       print version
EOF
}

# ---------- quick actions (curated; dispatch table, touches no m_* function) ----------
quick_run() {
  case "$1" in
    gw)       run ping -c4 "${GW:-1.1.1.1}" ;;
    arp)      need_iface || return; require arp-scan arp-scan || return
              run sudo arp-scan --interface="$IFACE" --localnet ;;
    nsn)      local n; n="$(ask_cidr "Subnet:" "$CIDR")" || return; page sudo nmap -sn "$n" ;;
    lldp)     require lldpcli lldpd || return; page sudo lldpcli show neighbors ;;
    selftest) clear; do_selftest; pause ;;
    sweep)    gen_sweep ;;
    *) : ;;
  esac
}

m_quick() {
  local k; k="$(menu "⚡ Quick checks" \
    "gw|Ping gateway" \
    "arp|ARP sweep (layer-2)" \
    "nsn|Nmap ping sweep" \
    "lldp|LLDP neighbour (switch / port)" \
    "selftest|Self-test (tools + live network)" \
    "sweep|Full sweep → report" \
    "back|‹ back")"
  case "$k" in ""|back) return ;; *) quick_run "$k" ;; esac
}

show_help() {
  local -a pager=(less -R); have gum && pager=(gum pager)
  cat <<'H' | "${pager[@]}"
netkit — quick help

NAVIGATION
  up/down           move
  Enter             select
  Esc               cancel / go back
  Ctrl-C            stop the running check, return to the menu
  Enter (return)    leave a result screen

CATEGORIES
  Quick        the checks you run at every drop
  Discovery    who's on the wire (arp, fping, nmap, mDNS, AV gear, IPv6)
  Link         iperf3 + PASS/FAIL, WAN speed, mtr, ping graph
  WiFi         wavemon, AP scans
  Packet       termshark, tcpdump, iftop, bandwhich
  DNS/HTTP     dig, PTR, HTTP headers, port check, SMTP
  LLDP/SNMP    switch neighbour, SNMP (ports, PoE, traffic) - v2c/v3
  DevCtrl      RS232/TCP/UDP send+read, live session, saved devices, PJLink
  OT/Building  Modbus (mbpoll), BACnet (nmap+rusty-bacnet), KNX (knxtool), ICS sweep
  AV-over-IP   IGMP, multicast groups, omping, PTP
  IoT          MQTT, Wake-on-LAN
  BT/RF        Bluetooth, RTL-SDR (433/868), spectrum sweep
  Reporting    snapshot, full sweep, save-last-output, vnstat, asciinema
  System       interfaces, ethtool, ipcalc, routes, DNS, tmux dash
  Site         per-location prefilled defaults

TIPS
  - Missing a tool? netkit offers to run 'netkit setup' on the spot.
  - NO_COLOR=1 netkit  disables colour.
  - Reports land in ~/netkit-reports/<site>/<date>/
H
}

# One-time nudge on a fresh unit (gated by a flag file so it never nags).
first_run_check() {
  local flag="$NETKIT_CFG_DIR/onboarded"
  [ -f "$flag" ] && return 0
  mkdir -p "$NETKIT_CFG_DIR"
  clear; banner; echo
  if ! have nmap || ! have gum; then warn "Some core tools look missing — run 'netkit setup'."; fi
  [ -z "$NETKIT_SITE" ] && warn "No active site — set one under 🏷 Site to prefill prompts."
  echo "  Pick ❓ Help / keys any time for a cheat-sheet."
  echo; pause
  : > "$flag"
}

# ---------- main ----------
load_site

case "${1:-}" in
  dash) run_dash; exit 0 ;;
  report) gen_report; exit 0 ;;
  sweep) gen_sweep; exit 0 ;;
  setup|--setup) do_setup; exit 0 ;;
  selftest|--selftest) do_selftest; exit 0 ;;
  doctor|--doctor) do_doctor; exit 0 ;;
  site|--site) do_site "${2:-}"; exit 0 ;;
  autostart|--autostart) do_autostart "${2:-}"; exit 0 ;;
  update|--update) do_update "${2:-}"; exit 0 ;;
  uninstall|--uninstall) do_uninstall; exit 0 ;;
  version|--version|-v) echo "netkit v${NETKIT_VERSION}"; exit 0 ;;
  help|--help|-h) usage; exit 0 ;;
esac

# Ctrl-C aborts the current ACTION and bounces back to the menu rather than
# killing netkit mid-job. A foreground child (tcpdump, ptp4l, wavemon…) receives
# the SIGINT first and exits; because `set -e` is off, control then falls through
# to the action's pause and back here. The handler only restores the terminal —
# it must NOT call continue/break (it can fire inside a $() subshell).
netkit_on_int() { stty sane 2>/dev/null || true; printf '\n'; }
trap 'netkit_on_int' INT

first_run_check

