m_iot() {
  local k; k="$(menu "🏠 Smart Home / IoT" \
    "sub|MQTT subscribe (watch a topic)" \
    "pub|MQTT publish (send a test message)" \
    "wol|Wake-on-LAN (send magic packet)" \
    "back|‹ back")"
  case "$k" in
    sub) require mosquitto_sub mosquitto-clients || return
         local h t; h="$(ask_req "Broker IP:" "${SITE_MQTT:-$GW}")" || return
         t="$(ask "Topic (blank = # = all):" "#")"; [ -z "$t" ] && t="#"
         run mosquitto_sub -h "$h" -t "$t" -v ;;
    pub) require mosquitto_pub mosquitto-clients || return
         local h t m; h="$(ask_req "Broker IP:" "${SITE_MQTT:-$GW}")" || return
         t="$(ask_req "Topic:" "netkit/test")" || return
         m="$(ask_req "Message:" "hello")" || return
         run mosquitto_pub -h "$h" -t "$t" -m "$m" ;;
    wol) require wakeonlan wakeonlan || return
         local mac; mac="$(ask_req "Target MAC (aa:bb:cc:dd:ee:ff):" "")" || return
         run wakeonlan "$mac" ;;
    *) return ;;
  esac
}

m_avoip() {
  need_iface || return
  local k; k="$(menu "🎚 AV-over-IP ($IFACE)" \
    "igmp|IGMP querier + reports (passive watch)" \
    "groups|Discover multicast groups (nmap)" \
    "joined|Multicast groups joined on this host" \
    "omping|Multicast flow test (needs 2nd device)" \
    "ptpwatch|PTP traffic + grandmaster (passive)" \
    "ptpmon|PTP offset monitor (runs ptp4l client)" \
    "back|‹ back")"
  case "$k" in
    igmp) run sudo tcpdump -i "$IFACE" -n -v igmp ;;
    groups) page sudo nmap --script broadcast-igmp-discovery -e "$IFACE" ;;
    joined) run ip maddr show ;;
    omping) if have omping; then
              local self peer; self="$(ask_req "This device IP:" "${SELFIP:-}")" || return
              peer="$(ask_req "Peer IP (also running omping):" "${SITE_PEER:-}")" || return
              run omping "$self" "$peer"
            else clear
              echo "omping isn't installed — and it can't be auto-installed:"
              echo "  • not in Debian/Raspberry Pi OS apt"
              echo "  • ships only as source (no arm64 binary), and netkit never compiles on the Pi"
              echo "To use this 2-device multicast test, build it yourself:"
              echo "  github.com/troglobit/omping  (make && sudo make install)"
              echo
              echo "The single-device multicast checks above (IGMP, groups, joined) still work."
              pause; fi ;;
    ptpwatch) run sudo tcpdump -i "$IFACE" -n -v udp port 319 or udp port 320 ;;
    ptpmon) require ptp4l linuxptp || return
            clear
            echo "Runs a PTP client on $IFACE to read offset from the grandmaster."
            echo "NOTE: this may step the system clock. Ctrl-C to stop."
            echo
            read -rp "↩ Enter to start (Ctrl-C to cancel)… " _
            run sudo ptp4l -i "$IFACE" -s -m -S ;;
    *) return ;;
  esac
}

m_rf() {
  local k; k="$(menu "📶 Bluetooth / RF" \
    "btscan|Bluetooth scan (BLE + classic, onboard)" \
    "btinfo|Bluetooth adapter info" \
    "btmon|Bluetooth live monitor (HCI trace)" \
    "sub|Sub-GHz decode 433/868 MHz (RTL-SDR)" \
    "mqtt|Sub-GHz → MQTT (publish decoded sensors)" \
    "sweep|Spectrum sweep (RTL-SDR → CSV)" \
    "sdrtest|Test RTL-SDR dongle is present" \
    "back|‹ back")"
  case "$k" in
    btscan) bt_scan ;;
    btinfo) require bluetoothctl bluez || return; run bluetoothctl show ;;
    btmon) require btmon bluez || return; run sudo btmon ;;
    sub) require rtl_433 "rtl-433 + RTL-SDR dongle" || return
         local fr; fr="$(ask_req "Frequency:" "433.92M")" || return
         run rtl_433 -f "$fr" ;;
    mqtt) require rtl_433 "rtl-433 + RTL-SDR dongle" || return
          local fr br; br="$(ask_req "MQTT broker IP:" "${SITE_MQTT:-$GW}")" || return
          fr="$(ask_req "Frequency:" "433.92M")" || return
          run rtl_433 -f "$fr" -F "mqtt://$br:1883" ;;
    sweep) require rtl_power "rtl-sdr + RTL-SDR dongle" || return
           local lo hi out; lo="$(ask_req "Start freq:" "433M")" || return
           hi="$(ask_req "End freq:" "435M")" || return
           out="$(report_dir)/sweep-$(date +%Y%m%d-%H%M).csv"
           # Quoted args, no bash -c: freq/path metacharacters cannot execute.
           clear; echo "\$ rtl_power -f ${lo}:${hi}:1k -g 25 -i 1 -1 $out"
           echo "------------------------------------------"
           rtl_power -f "${lo}:${hi}:1k" -g 25 -i 1 -1 "$out" && echo "Wrote $out"
           pause ;;
    sdrtest) require rtl_test rtl-sdr || return; run rtl_test -t ;;
    *) return ;;
  esac
}

bt_scan() {
  require bluetoothctl bluez || return
  local secs; secs="$(ask_num "Scan seconds:" "12")" || return
  clear
  echo "\$ bluetoothctl --timeout $secs scan on"
  echo "------------------------------------------"
  bluetoothctl power on >/dev/null 2>&1
  bluetoothctl --timeout "$secs" scan on
  echo; echo "Discovered devices:"; bluetoothctl devices
  pause
}

m_report() {
  local k; k="$(menu "📊 Reporting" \
    "snap|Site snapshot → markdown report" \
    "sweep|Full sweep → branded report (PDF-ready)" \
    "savelast|Save last viewed output → report" \
    "vnstat|vnstat traffic summary" \
    "rec|Record terminal session (asciinema)" \
    "back|‹ back")"
  case "$k" in
    snap) gen_report ;;
    sweep) gen_sweep ;;
    savelast) save_last_report ;;
    vnstat) run vnstat ;;
