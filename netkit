    "devctl|🎛 Device Control (RS232 / IP)" \
    "avoip|🎚 AV-over-IP (multicast / PTP)" \
    "iot|🏠 Smart Home / IoT" \
    "rf|📶 Bluetooth / RF" \
    "ot|🏭 Building / OT" \
    "report|📊 Reporting" \
    "system|⚙️ System / Network info" \
    "site|🏷 Site profile" \
    "help|❓ Help / keys" \
    "quit|✖ Quit")"
  case "$k" in
