# Append the most recent paged output (set by page()) to a dated capture file.
save_last_report() {
  if [ -z "$NETKIT_LAST_OUTPUT" ]; then
    clear; echo "Nothing captured yet — run a check that pages its output first."; pause; return
  fi
  local dir f fence ts; dir="$(report_dir)"; f="$dir/captures-$(date +%Y%m%d).md"
  fence='```'; ts="$(date '+%H:%M:%S')"
  printf '\n## %s\n\n%s\n%s\n%s\n' "$ts" "$fence" "$NETKIT_LAST_OUTPUT" "$fence" >> "$f"
  clear; echo "Appended to $f"; pause
}

