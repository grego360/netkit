#!/usr/bin/env bash
# netkit v2 — categorised network toolkit dashboard for a Pi 5 handheld
# Usage: netkit            (interactive dashboard)
#        netkit dash       (tiled live view in tmux)
#        netkit report     (write a site-snapshot markdown report)
set -uo pipefail

# ---------- helpers ----------
have() { command -v "$1" >/dev/null 2>&1; }
C_ACCENT="212"

banner() {
  if have gum; then
    gum style --border rounded --padding "0 2" \
      --border-foreground "$C_ACCENT" --foreground "$C_ACCENT" \
      "netkit" "network toolkit"
  else
    echo "== netkit =="
  fi
}

# menu "Header" "key|Label" ...  -> prints the chosen key (empty if cancelled)
menu() {
  local header="$1"; shift
  local labels=() keys=() pair
  for pair in "$@"; do keys+=("${pair%%|*}"); labels+=("${pair#*|}"); done
  local chosen=""
  if have gum; then
    chosen="$(printf '%s\n' "${labels[@]}" | gum choose --header "$header" --height 14)"
  else
    local PS3="$header  > " opt
    select opt in "${labels[@]}"; do chosen="$opt"; break; done
  fi
  [ -z "$chosen" ] && { echo ""; return; }
  local i
  for i in "${!labels[@]}"; do
    [ "${labels[$i]}" = "$chosen" ] && { echo "${keys[$i]}"; return; }
  done
  echo ""
}

ask() { # prompt, default  -> prints answer
  local p="$1" d="${2:-}"
  if have gum; then gum input --prompt "$p " --value "$d"
  else local v; read -rp "$p [$d]: " v; echo "${v:-$d}"; fi
}

# ask_req: like ask but returns non-zero (aborts the action) on empty input
ask_req() {
  local v; v="$(ask "$1" "${2:-}")"
  [ -z "$v" ] && return 1
  printf '%s' "$v"
}

pause() { echo; read -rp "↩  Enter to return to menu… " _; }

run() { clear; echo "\$ $*"; echo "------------------------------------------"; "$@"; pause; }
runsh() { clear; echo "\$ $1"; echo "------------------------------------------"; bash -c "$1"; pause; }

need_iface() {
  [ -n "$IFACE" ] && return 0
  clear; echo "No usable network interface detected."; pause; return 1
}

# ---------- live network facts ----------
# Prefer an interface that is UP and holds a global IPv4 (handles the common
# survey case of plugging into a switch with no default route). Fall back to
# the default-route interface, then to the first non-loopback link.
IFACE="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{print $2; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip -o link show up 2>/dev/null | awk -F': ' '$2!="lo"{print $2; exit}')"

GW="$(ip route show default 2>/dev/null | awk '{print $3; exit}')"
CIDR="$(ip -o -f inet addr show "${IFACE:-lo}" 2>/dev/null | awk '{print $4; exit}')"
SELFIP="${CIDR%%/*}"

# Wireless interface is detected separately from the working interface.
WIFACE="$(for d in /sys/class/net/*/wireless; do
  [ -e "$d" ] && basename "$(dirname "$d")" && break; done)"

# ---------- categories ----------
m_discovery() {
  local k; k="$(menu "🔍  Discovery" \
    "arp|ARP sweep (layer-2, fast)" \
    "nsn|Nmap ping sweep (-sn)" \
    "nsv|Nmap service scan (-sV)" \
    "mdns|mDNS / Bonjour browse" \
    "back|‹ back")"
  case "$k" in
    arp)  need_iface || return; run sudo arp-scan --interface="$IFACE" --localnet ;;
    nsn)  local n; n="$(ask_req "Subnet:" "$CIDR")" || return; run sudo nmap -sn "$n" ;;
    nsv)  local h; h="$(ask_req "Host:" "$GW")" || return; run sudo nmap -sV -T4 --top-ports 200 "$h" ;;
    mdns) run avahi-browse -a -t -r ;;
    *) return ;;
  esac
}

m_link() {
  local k; k="$(menu "🔗  Link & Throughput" \
    "isrv|iperf3 — run as SERVER (listen)" \
    "icli|iperf3 — run as CLIENT (test to server)" \
    "mtr|mtr (latency + loss to host)" \
    "ping|ping graph" \
    "back|‹ back")"
  case "$k" in
    isrv) run iperf3 -s ;;
    icli) local s; s="$(ask_req "Server IP:" "$GW")" || return; run iperf3 -c "$s" ;;
    mtr)  local h; h="$(ask_req "Host:" "1.1.1.1")" || return; run mtr "$h" ;;
    ping) local h; h="$(ask_req "Host:" "$GW")" || return
          if have gping; then run gping "$h"; else run ping "$h"; fi ;;
    *) return ;;
  esac
}

m_wifi() {
  if [ -z "$WIFACE" ]; then
    clear; echo "No wireless interface found on this unit."; pause; return
  fi
  local k; k="$(menu "📡  WiFi ($WIFACE)" \
    "wm|wavemon (live signal/noise)" \
    "nm|Scan nearby APs (nmcli)" \
    "iw|Scan nearby APs (iw)" \
    "back|‹ back")"
  case "$k" in
    wm) run wavemon -i "$WIFACE" ;;
    nm) run nmcli -f IN-USE,SSID,CHAN,SIGNAL,SECURITY device wifi list ;;
    iw) run sudo iw dev "$WIFACE" scan ;;
    *) return ;;
  esac
}

m_packet() {
  need_iface || return
  local k; k="$(menu "🧰  Packet Inspection ($IFACE)" \
    "ts|termshark (TUI Wireshark, live)" \
    "td|tcpdump (quick capture)" \
    "iftop|iftop (per-connection bandwidth)" \
    "bw|bandwhich (per-process bandwidth)" \
    "back|‹ back")"
  case "$k" in
    ts) local f; f="$(ask "Capture filter (blank = all):" "")"
        if [ -n "$f" ]; then run termshark -i "$IFACE" -f "$f"; else run termshark -i "$IFACE"; fi ;;
    td) local f; f="$(ask "Filter (e.g. 'port 53'):" "")"
        runsh "sudo tcpdump -i $IFACE -n $f" ;;
    iftop) run sudo iftop -i "$IFACE" ;;
    bw) if have bandwhich; then run sudo bandwhich
        else clear; echo "bandwhich not installed (re-run installer, choose extras)."; pause; fi ;;
    *) return ;;
  esac
}

m_dns() {
  local k; k="$(menu "🌐  DNS & HTTP" \
    "dig|dig (lookup a record)" \
    "ptr|Reverse DNS (PTR)" \
    "http|HTTP headers check" \
    "port|Port open? (ncat)" \
    "back|‹ back")"
  case "$k" in
    dig)  local d ty; d="$(ask_req "Domain:" "modalav.co.uk")" || return
          ty="$(menu "Record type" "A|A" "AAAA|AAAA" "MX|MX" "TXT|TXT" "NS|NS" "CNAME|CNAME" "SOA|SOA")"
          [ -z "$ty" ] && return
          run dig +noall +answer "$d" "$ty" ;;
    ptr)  local ip; ip="$(ask_req "IP:" "$GW")" || return; run dig -x "$ip" +short ;;
    http) local u; u="$(ask_req "URL:" "https://modalav.co.uk")" || return
          if have xh; then run xh -I "$u"; else run curl -sSIL "$u"; fi ;;
    port) local h p; h="$(ask_req "Host:" "$GW")" || return; p="$(ask_req "Port:" "443")" || return
          run ncat -zv "$h" "$p" ;;
    *) return ;;
  esac
}

m_lldp() {
  local k; k="$(menu "🔌  Switch Port (LLDP)" \
    "show|Show neighbours (which switch/port/VLAN)" \
    "watch|Watch neighbours (live)" \
    "back|‹ back")"
  case "$k" in
    show)  run sudo lldpcli show neighbors ;;
    watch) run sudo watch -n2 lldpcli show neighbors ;;
    *) return ;;
  esac
}

m_report() {
  local k; k="$(menu "📊  Reporting" \
    "snap|Site snapshot → markdown report" \
    "vnstat|vnstat traffic summary" \
    "rec|Record terminal session (asciinema)" \
    "back|‹ back")"
  case "$k" in
    snap)   gen_report ;;
    vnstat) run vnstat ;;
    rec)    local f; f="$HOME/netkit-reports/session-$(date +%Y%m%d-%H%M).cast"
            mkdir -p "$HOME/netkit-reports"; run asciinema rec "$f" ;;
    *) return ;;
  esac
}

m_system() {
  local k; k="$(menu "⚙️  System / Network info" \
    "if|Interface overview" \
    "rt|Routing table" \
    "dns|DNS resolver status" \
    "dash|Live tiled dashboard (tmux)" \
    "back|‹ back")"
  case "$k" in
    if)   run ip -c -br addr ;;
    rt)   run ip -c route ;;
    dns)  if have resolvectl; then run resolvectl status; else run cat /etc/resolv.conf; fi ;;
    dash) run_dash ;;
    *) return ;;
  esac
}

# ---------- report generator ----------
gen_report() {
  need_iface || return
  local dir="$HOME/netkit-reports"; mkdir -p "$dir"
  local ts; ts="$(date +%Y%m%d-%H%M)"
  local f="$dir/snapshot-$ts.md"
  clear
  echo "Gathering snapshot (arp-scan + nmap ping sweep)… a few seconds."
  local arp nmap_sn
  arp="$(sudo arp-scan --interface="$IFACE" --localnet 2>/dev/null | grep -E '^[0-9]' || echo 'arp-scan unavailable')"
  nmap_sn="$(sudo nmap -sn "${CIDR:-$IFACE}" 2>/dev/null | grep -E 'Nmap scan report' || echo 'nmap unavailable')"

  cat > "$f" <<RPT
# Network Site Snapshot

- **Date:** $(date '+%Y-%m-%d %H:%M %Z')
- **Captured from:** $(hostname) (${SELFIP:-no-ip}) on \`${IFACE}\`
- **Gateway:** ${GW:-none}
- **Subnet:** ${CIDR:-none}

## Interfaces
\`\`\`
$(ip -br addr)
\`\`\`

## Routing
\`\`\`
$(ip route)
\`\`\`

## Layer-2 hosts (arp-scan)
\`\`\`
$arp
\`\`\`

## Live hosts (nmap ping sweep)
\`\`\`
$nmap_sn
\`\`\`

## LLDP neighbour (switch / port / VLAN)
\`\`\`
$(sudo lldpcli show neighbors 2>/dev/null || echo 'no LLDP neighbour seen')
\`\`\`

---
*Generated by netkit.*
RPT

  clear
  echo "Report written: $f"; echo
  if have glow; then glow -p "$f"; else cat "$f"; fi
  echo
  echo "Export a PDF:  pandoc \"$f\" -o \"${f%.md}.pdf\""
  pause
}

# ---------- tiled live dashboard ----------
run_dash() {
  if ! have tmux; then clear; echo "tmux not installed."; pause; return; fi
  need_iface || return
  local S="netkit-dash"
  tmux kill-session -t "$S" 2>/dev/null
  local pinger="ping ${GW:-1.1.1.1}"; have gping && pinger="gping ${GW:-1.1.1.1}"
  tmux new-session -d -s "$S" -n dash "watch -n2 'ip -br addr; echo; ip route'"
  tmux split-window -h -t "$S":0 "$pinger"
  tmux split-window -v -t "$S":0.0 "mtr ${GW:-1.1.1.1}"
  tmux split-window -v -t "$S":0.1 "vnstat -l -i $IFACE 2>/dev/null || watch -n2 'cat /proc/net/dev'"
  tmux select-layout -t "$S":0 tiled
  tmux attach -t "$S"
}

# ---------- main ----------
case "${1:-}" in
  dash)   run_dash; exit 0 ;;
  report) gen_report; exit 0 ;;
esac

while true; do
  clear; banner
  echo "  iface: ${IFACE:-?}   ip: ${SELFIP:-?}   gw: ${GW:-?}   wifi: ${WIFACE:-none}"; echo
  k="$(menu "Pick a category" \
    "discovery|🔍  Discovery" \
    "link|🔗  Link & Throughput" \
    "wifi|📡  WiFi" \
    "packet|🧰  Packet Inspection" \
    "dns|🌐  DNS & HTTP" \
    "lldp|🔌  Switch Port (LLDP)" \
    "report|📊  Reporting" \
    "system|⚙️  System / Network info" \
    "quit|✖  Quit")"
  case "$k" in
    discovery) m_discovery ;;
    link)      m_link ;;
    wifi)      m_wifi ;;
    packet)    m_packet ;;
    dns)       m_dns ;;
    lldp)      m_lldp ;;
    report)    m_report ;;
    system)    m_system ;;
    *) clear; exit 0 ;;
  esac
done
