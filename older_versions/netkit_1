#!/usr/bin/env bash
# netkit v3 — categorised network toolkit dashboard for a Pi 5 handheld
# Usage: netkit              (interactive dashboard)
#        netkit dash         (tiled live view in tmux)
#        netkit report       (write a site-snapshot markdown report)
#        netkit setup        (install/refresh extra dependencies)
#        netkit selftest      (bench check: tools present + live sweep)
#        netkit update [URL]  (re-pull this script from a raw gist URL)
#        netkit uninstall     (remove the netkit binary)
#        netkit version | help
set -uo pipefail

NETKIT_VERSION="3.2.0"
NETKIT_BIN="/usr/local/bin/netkit"
NETKIT_CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/netkit"

# ---------- helpers ----------
have() { command -v "$1" >/dev/null 2>&1; }
C_ACCENT="212"

banner() {
  if have gum; then
    gum style --border rounded --padding "0 2" \
      --border-foreground "$C_ACCENT" --foreground "$C_ACCENT" \
      "netkit" "network toolkit"
  else
    echo "== netkit =="
  fi
}

# menu "Header" "key|Label" ... -> prints the chosen key (empty if cancelled)
menu() {
  local header="$1"; shift
  local labels=() keys=() pair
  for pair in "$@"; do keys+=("${pair%%|*}"); labels+=("${pair#*|}"); done
  local chosen=""
  if have gum; then
    chosen="$(printf '%s\n' "${labels[@]}" | gum choose --header "$header" --height 16)"
  else
    local PS3="$header > " opt
    select opt in "${labels[@]}"; do chosen="$opt"; break; done
  fi
  [ -z "$chosen" ] && { echo ""; return; }
  local i
  for i in "${!labels[@]}"; do
    [ "${labels[$i]}" = "$chosen" ] && { echo "${keys[$i]}"; return; }
  done
  echo ""
}

ask() { # prompt, default -> prints answer
  local p="$1" d="${2:-}"
  if have gum; then gum input --prompt "$p " --value "$d"
  else local v; read -rp "$p [$d]: " v; echo "${v:-$d}"; fi
}

# ask_req: like ask but returns non-zero (aborts the action) on empty input
ask_req() {
  local v; v="$(ask "$1" "${2:-}")"
  [ -z "$v" ] && return 1
  printf '%s' "$v"
}

pause() { echo; read -rp "↩ Enter to return to menu… " _; }

run() { clear; echo "\$ $*"; echo "------------------------------------------"; "$@"; pause; }
runsh() { clear; echo "\$ $1"; echo "------------------------------------------"; bash -c "$1"; pause; }

need_iface() {
  [ -n "$IFACE" ] && return 0
  clear; echo "No usable network interface detected."; pause; return 1
}

# tiny status printers reused by setup/selftest
say()  { printf '\n\033[1;35m▶ %s\033[0m\n' "$*"; }
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }

# ---------- live network facts ----------
# Prefer an interface that is UP and holds a global IPv4 (handles the common
# survey case of plugging into a switch with no default route). Fall back to
# the default-route interface, then to the first non-loopback link.
IFACE="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{print $2; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip route show default 2>/dev/null | awk '{print $5; exit}')"
[ -z "${IFACE:-}" ] && IFACE="$(ip -o link show up 2>/dev/null | awk -F': ' '$2!="lo"{print $2; exit}')"

GW="$(ip route show default 2>/dev/null | awk '{print $3; exit}')"
CIDR="$(ip -o -f inet addr show "${IFACE:-lo}" 2>/dev/null | awk '{print $4; exit}')"
SELFIP="${CIDR%%/*}"

# Wireless interface is detected separately from the working interface.
WIFACE="$(for d in /sys/class/net/*/wireless; do
  [ -e "$d" ] && basename "$(dirname "$d")" && break; done)"

# Best wired interface (for ethtool / link-speed checks)
WIRED="$(for d in /sys/class/net/*; do
  n="$(basename "$d")"
  [ "$n" = "lo" ] && continue
  [ -e "$d/wireless" ] && continue
  [ -e "$d/device" ] && { echo "$n"; break; }
done)"

# ---------- categories ----------
m_discovery() {
  local k; k="$(menu "🔍 Discovery" \
    "arp|ARP sweep (layer-2, fast)" \
    "fp|fping sweep (which IPs answer)" \
    "nsn|Nmap ping sweep (-sn)" \
    "nsv|Nmap service scan (-sV)" \
    "mdns|mDNS / Bonjour browse (all)" \
    "av|AV gear (Dante / NDI / AirPlay / Sonos)" \
    "back|‹ back")"
  case "$k" in
    arp) need_iface || return; run sudo arp-scan --interface="$IFACE" --localnet ;;
    fp)  local n; n="$(ask_req "Subnet:" "$CIDR")" || return
         if have fping; then runsh "fping -a -g $n 2>/dev/null"
         else clear; echo "fping not installed — run: netkit setup"; pause; fi ;;
    nsn) local n; n="$(ask_req "Subnet:" "$CIDR")" || return; run sudo nmap -sn "$n" ;;
    nsv) local h; h="$(ask_req "Host:" "$GW")" || return; run sudo nmap -sV -T4 --top-ports 200 "$h" ;;
    mdns) run avahi-browse -a -t -r ;;
    av) run av_browse ;;
    *) return ;;
  esac
}

# Browse the mDNS service types AV / smart-home gear advertises.
av_browse() {
  if ! have avahi-browse; then echo "avahi-browse missing (apt install avahi-utils)"; return; fi
  local types=(
    _netaudio-arc._udp _netaudio-cmc._udp _netaudio-chan._udp   # Dante
    _ndi._tcp                                                   # NDI
    _airplay._tcp _raop._tcp                                    # AirPlay / AirTunes
    _googlecast._tcp                                            # Chromecast / Cast
    _sonos._tcp _spotify-connect._tcp                           # Sonos / Spotify
  )
  local ty hit=0
  for ty in "${types[@]}"; do
    local out
    out="$(avahi-browse -t -r -p "$ty" 2>/dev/null \
            | awk -F';' '/^=/{printf "    %-28s %s:%s  (%s)\n", $4, $8, $9, $7}')"
    if [ -n "$out" ]; then
      printf '  %s\n%s\n' "$ty" "$out"; hit=1
    fi
  done
  [ "$hit" -eq 0 ] && echo "  No AV/mDNS services seen on this network."
}

m_link() {
  local k; k="$(menu "🔗 Link & Throughput" \
    "isrv|iperf3 — run as SERVER (listen)" \
    "icli|iperf3 — run as CLIENT (test to server)" \
    "wan|WAN speed test (to the internet)" \
    "mtr|mtr (latency + loss to host)" \
    "ping|ping graph" \
    "back|‹ back")"
  case "$k" in
    isrv) run iperf3 -s ;;
    icli) local s; s="$(ask_req "Server IP:" "$GW")" || return; run iperf3 -c "$s" ;;
    wan)  if have librespeed-cli; then run librespeed-cli --no-icmp
          else clear; echo "librespeed-cli not installed — run: netkit setup"; pause; fi ;;
    mtr) local h; h="$(ask_req "Host:" "1.1.1.1")" || return; run mtr "$h" ;;
    ping) local h; h="$(ask_req "Host:" "$GW")" || return
          if have gping; then run gping "$h"; else run ping "$h"; fi ;;
    *) return ;;
  esac
}

m_wifi() {
  if [ -z "$WIFACE" ]; then
    clear; echo "No wireless interface found on this unit."; pause; return
  fi
  local k; k="$(menu "📡 WiFi ($WIFACE)" \
    "wm|wavemon (live signal/noise)" \
    "nm|Scan nearby APs (nmcli)" \
    "iw|Scan nearby APs (iw)" \
    "back|‹ back")"
  case "$k" in
    wm) run wavemon -i "$WIFACE" ;;
    nm) run nmcli -f IN-USE,SSID,CHAN,SIGNAL,SECURITY device wifi list ;;
    iw) run sudo iw dev "$WIFACE" scan ;;
    *) return ;;
  esac
}

m_packet() {
  need_iface || return
  local k; k="$(menu "🧰 Packet Inspection ($IFACE)" \
    "ts|termshark (TUI Wireshark, live)" \
    "td|tcpdump (quick capture)" \
    "iftop|iftop (per-connection bandwidth)" \
    "bw|bandwhich (per-process bandwidth)" \
    "back|‹ back")"
  case "$k" in
    ts) local f; f="$(ask "Capture filter (blank = all):" "")"
        if [ -n "$f" ]; then run termshark -i "$IFACE" -f "$f"; else run termshark -i "$IFACE"; fi ;;
    td) local f; f="$(ask "Filter (e.g. 'port 53'):" "")"
        runsh "sudo tcpdump -i $IFACE -n $f" ;;
    iftop) run sudo iftop -i "$IFACE" ;;
    bw) if have bandwhich; then run sudo bandwhich
        else clear; echo "bandwhich not installed — run: netkit setup"; pause; fi ;;
    *) return ;;
  esac
}

m_dns() {
  local k; k="$(menu "🌐 DNS & HTTP" \
    "dig|dig (lookup a record)" \
    "ptr|Reverse DNS (PTR)" \
    "http|HTTP headers check" \
    "port|Port open? (ncat)" \
    "back|‹ back")"
  case "$k" in
    dig) local d ty; d="$(ask_req "Domain:" "modalav.co.uk")" || return
         ty="$(menu "Record type" "A|A" "AAAA|AAAA" "MX|MX" "TXT|TXT" "NS|NS" "CNAME|CNAME" "SOA|SOA")"
         [ -z "$ty" ] && return
         run dig +noall +answer "$d" "$ty" ;;
    ptr) local ip; ip="$(ask_req "IP:" "$GW")" || return; run dig -x "$ip" +short ;;
    http) local u; u="$(ask_req "URL:" "https://modalav.co.uk")" || return
          if have xh; then run xh -I "$u"; else run curl -sSIL "$u"; fi ;;
    port) local h p; h="$(ask_req "Host:" "$GW")" || return; p="$(ask_req "Port:" "443")" || return
          run ncat -zv "$h" "$p" ;;
    *) return ;;
  esac
}

m_lldp() {
  local k; k="$(menu "🔌 Switch Port (LLDP / SNMP)" \
    "show|Show neighbours (which switch/port/VLAN)" \
    "watch|Watch neighbours (live)" \
    "snmp|SNMP query a managed switch (system info)" \
    "back|‹ back")"
  case "$k" in
    show) run sudo lldpcli show neighbors ;;
    watch) run sudo watch -n2 lldpcli show neighbors ;;
    snmp) if ! have snmpwalk; then clear; echo "snmp not installed — run: netkit setup"; pause; return; fi
          local h c; h="$(ask_req "Switch IP:" "$GW")" || return
          c="$(ask_req "SNMP community:" "public")" || return
          # 1.3.6.1.2.1.1 = system group (sysDescr/sysName/etc); numeric OIDs avoid needing MIBs
          run snmpwalk -v2c -c "$c" -t 2 -r 1 "$h" 1.3.6.1.2.1.1 ;;
    *) return ;;
  esac
}

m_iot() {
  local k; k="$(menu "🏠 Smart Home / IoT" \
    "sub|MQTT subscribe (watch a topic)" \
    "pub|MQTT publish (send a test message)" \
    "wol|Wake-on-LAN (send magic packet)" \
    "back|‹ back")"
  case "$k" in
    sub) if ! have mosquitto_sub; then clear; echo "mosquitto-clients not installed — run: netkit setup"; pause; return; fi
         local h t; h="$(ask_req "Broker IP:" "$GW")" || return
         t="$(ask "Topic (blank = # = all):" "#")"; [ -z "$t" ] && t="#"
         run mosquitto_sub -h "$h" -t "$t" -v ;;
    pub) if ! have mosquitto_pub; then clear; echo "mosquitto-clients not installed — run: netkit setup"; pause; return; fi
         local h t m; h="$(ask_req "Broker IP:" "$GW")" || return
         t="$(ask_req "Topic:" "netkit/test")" || return
         m="$(ask_req "Message:" "hello")" || return
         run mosquitto_pub -h "$h" -t "$t" -m "$m" ;;
    wol) if ! have wakeonlan; then clear; echo "wakeonlan not installed — run: netkit setup"; pause; return; fi
         local mac; mac="$(ask_req "Target MAC (aa:bb:cc:dd:ee:ff):" "")" || return
         run wakeonlan "$mac" ;;
    *) return ;;
  esac
}

m_rf() {
  local k; k="$(menu "📶 Bluetooth / RF" \
    "btscan|Bluetooth scan (BLE + classic, onboard)" \
    "btinfo|Bluetooth adapter info" \
    "btmon|Bluetooth live monitor (HCI trace)" \
    "sub|Sub-GHz decode 433/868 MHz (RTL-SDR)" \
    "mqtt|Sub-GHz → MQTT (publish decoded sensors)" \
    "sweep|Spectrum sweep (RTL-SDR → CSV)" \
    "sdrtest|Test RTL-SDR dongle is present" \
    "back|‹ back")"
  case "$k" in
    btscan) bt_scan ;;
    btinfo) if have bluetoothctl; then run bluetoothctl show
            else clear; echo "bluez not installed — run: netkit setup"; pause; fi ;;
    btmon) if have btmon; then run sudo btmon
           else clear; echo "btmon not installed — run: netkit setup"; pause; fi ;;
    sub) if have rtl_433; then
           local fr; fr="$(ask_req "Frequency:" "433.92M")" || return
           runsh "rtl_433 -f $fr"
         else clear; echo "rtl_433 not installed — run: netkit setup (also needs an RTL-SDR dongle)"; pause; fi ;;
    mqtt) if have rtl_433; then
            local fr br; br="$(ask_req "MQTT broker IP:" "$GW")" || return
            fr="$(ask_req "Frequency:" "433.92M")" || return
            # rtl_433 still prints decoded events to screen while publishing to the broker.
            # Default base topic is rtl_433/<hostname>; sensors arrive under …/devices/…
            runsh "rtl_433 -f $fr -F mqtt://$br:1883"
          else clear; echo "rtl_433 not installed — run: netkit setup (also needs an RTL-SDR dongle)"; pause; fi ;;
    sweep) if have rtl_power; then
             local lo hi out; lo="$(ask_req "Start freq:" "433M")" || return
             hi="$(ask_req "End freq:" "435M")" || return
             out="$HOME/netkit-reports/sweep-$(date +%Y%m%d-%H%M).csv"
             mkdir -p "$HOME/netkit-reports"
             runsh "rtl_power -f ${lo}:${hi}:1k -g 25 -i 1 -1 '$out' && echo \"Wrote $out\""
           else clear; echo "rtl_power not installed (rtl-sdr) — run: netkit setup (also needs an RTL-SDR dongle)"; pause; fi ;;
    sdrtest) if have rtl_test; then run rtl_test -t
             else clear; echo "rtl-sdr not installed — run: netkit setup"; pause; fi ;;
    *) return ;;
  esac
}

# Timed Bluetooth discovery using the onboard controller (bluetoothctl, not the
# deprecated hcitool lescan). Powers the adapter on, scans for N seconds, lists.
bt_scan() {
  if ! have bluetoothctl; then clear; echo "bluez not installed — run: netkit setup"; pause; return; fi
  local secs; secs="$(ask_req "Scan seconds:" "12")" || return
  clear
  echo "\$ bluetoothctl --timeout $secs scan on"
  echo "------------------------------------------"
  bluetoothctl power on >/dev/null 2>&1
  bluetoothctl --timeout "$secs" scan on
  echo
  echo "Discovered devices:"
  bluetoothctl devices
  pause
}

m_report() {
  local k; k="$(menu "📊 Reporting" \
    "snap|Site snapshot → markdown report" \
    "vnstat|vnstat traffic summary" \
    "rec|Record terminal session (asciinema)" \
    "back|‹ back")"
  case "$k" in
    snap) gen_report ;;
    vnstat) run vnstat ;;
    rec) local f; f="$HOME/netkit-reports/session-$(date +%Y%m%d-%H%M).cast"
         mkdir -p "$HOME/netkit-reports"; run asciinema rec "$f" ;;
    *) return ;;
  esac
}

m_system() {
  local k; k="$(menu "⚙️ System / Network info" \
    "if|Interface overview" \
    "eth|Wired link speed/duplex (ethtool)" \
    "subnet|Subnet calculator (ipcalc)" \
    "rt|Routing table" \
    "dns|DNS resolver status" \
    "dash|Live tiled dashboard (tmux)" \
    "back|‹ back")"
  case "$k" in
    if) run ip -c -br addr ;;
    eth) if ! have ethtool; then clear; echo "ethtool not installed — run: netkit setup"; pause; return; fi
         local dev; dev="$(ask_req "Interface:" "${WIRED:-$IFACE}")" || return
         run ethtool "$dev" ;;
    subnet) if ! have ipcalc; then clear; echo "ipcalc not installed — run: netkit setup"; pause; return; fi
            local c; c="$(ask_req "Address/CIDR:" "${CIDR:-192.168.1.0/24}")" || return
            run ipcalc "$c" ;;
    rt) run ip -c route ;;
    dns) if have resolvectl; then run resolvectl status; else run cat /etc/resolv.conf; fi ;;
    dash) run_dash ;;
    *) return ;;
  esac
}

# ---------- report generator ----------
gen_report() {
  need_iface || return
  local dir="$HOME/netkit-reports"; mkdir -p "$dir"
  local ts; ts="$(date +%Y%m%d-%H%M)"
  local f="$dir/snapshot-$ts.md"
  clear
  echo "Gathering snapshot (arp-scan + nmap ping sweep)… a few seconds."
  local arp nmap_sn
  arp="$(sudo arp-scan --interface="$IFACE" --localnet 2>/dev/null | grep -E '^[0-9]' || echo 'arp-scan unavailable')"
  nmap_sn="$(sudo nmap -sn "${CIDR:-$IFACE}" 2>/dev/null | grep -E 'Nmap scan report' || echo 'nmap unavailable')"

  cat > "$f" <<RPT
# Network Site Snapshot

- **Date:** $(date '+%Y-%m-%d %H:%M %Z')
- **Captured from:** $(hostname) (${SELFIP:-no-ip}) on \`${IFACE}\`
- **Gateway:** ${GW:-none}
- **Subnet:** ${CIDR:-none}

## Interfaces
\`\`\`
$(ip -br addr)
\`\`\`

## Routing
\`\`\`
$(ip route)
\`\`\`

## Layer-2 hosts (arp-scan)
\`\`\`
$arp
\`\`\`

## Live hosts (nmap ping sweep)
\`\`\`
$nmap_sn
\`\`\`

## LLDP neighbour (switch / port / VLAN)
\`\`\`
$(sudo lldpcli show neighbors 2>/dev/null || echo 'no LLDP neighbour seen')
\`\`\`

---
*Generated by netkit v${NETKIT_VERSION}.*
RPT

  clear
  echo "Report written: $f"; echo
  if have glow; then glow -p "$f"; else cat "$f"; fi
  echo
  echo "Export a PDF: pandoc \"$f\" -o \"${f%.md}.pdf\""
  pause
}

# ---------- tiled live dashboard ----------
run_dash() {
  if ! have tmux; then clear; echo "tmux not installed."; pause; return; fi
  need_iface || return
  local S="netkit-dash"
  tmux kill-session -t "$S" 2>/dev/null
  local pinger="ping ${GW:-1.1.1.1}"; have gping && pinger="gping ${GW:-1.1.1.1}"
  tmux new-session -d -s "$S" -n dash "watch -n2 'ip -br addr; echo; ip route'"
  tmux split-window -h -t "$S":0 "$pinger"
  tmux split-window -v -t "$S":0.0 "mtr ${GW:-1.1.1.1}"
  tmux split-window -v -t "$S":0.1 "vnstat -l -i $IFACE 2>/dev/null || watch -n2 'cat /proc/net/dev'"
  tmux select-layout -t "$S":0 tiled
  tmux attach -t "$S"
}

# ---------- dependency setup ----------
# Generic: download the latest GitHub release asset matching a regex and install
# the named binary to /usr/local/bin. Skips cleanly if no matching asset exists.
install_release_bin() { # repo  asset_regex  binname  friendly
  local repo="$1" rx="$2" bin="$3" friendly="${4:-$3}" url tmp found
  if have "$bin"; then ok "$friendly already present"; return 0; fi
  url="$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" 2>/dev/null \
        | jq -r '.assets[].browser_download_url' 2>/dev/null \
        | grep -Ei "$rx" | head -n1)"
  if [ -z "$url" ]; then warn "$friendly: no matching aarch64 asset found — skipped"; return 1; fi
  tmp="$(mktemp -d)"
  if curl -fsSL "$url" -o "$tmp/dl"; then
    case "$url" in
      *.tar.gz|*.tgz) tar -xzf "$tmp/dl" -C "$tmp" 2>/dev/null ;;
      *.tar.xz)       tar -xJf "$tmp/dl" -C "$tmp" 2>/dev/null ;;
      *.zip)          unzip -q "$tmp/dl" -d "$tmp" 2>/dev/null ;;
      *)              cp "$tmp/dl" "$tmp/$bin" ;;
    esac
    found="$(find "$tmp" -type f -name "$bin" | head -n1)"
    if [ -n "$found" ]; then
      sudo install -m 0755 "$found" "$NETKIT_BIN_DIR/$bin" && ok "$friendly installed"
    else
      warn "$friendly: binary not found inside archive — skipped"
    fi
  else
    warn "$friendly: download failed — skipped"
  fi
  rm -rf "$tmp"
}

NETKIT_BIN_DIR="/usr/local/bin"

do_setup() {
  if [ "${EUID:-$(id -u)}" -eq 0 ]; then
    echo "Run 'netkit setup' as your normal user (it calls sudo where needed)."; exit 1
  fi
  say "Installing extra apt packages (MQTT, ethtool, SNMP, Bluetooth, RTL-SDR, …)"
  local pkgs=(mosquitto-clients ethtool snmp fping ipcalc wakeonlan unzip
              bluez bluez-tools rtl-433 rtl-sdr)
  sudo apt-get update -y >/dev/null 2>&1 || warn "apt update had issues"
  if sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${pkgs[@]}"; then
    ok "apt extras installed"
  else
    warn "Some apt packages failed — re-run: sudo apt-get install ${pkgs[*]}"
  fi

  if getent group bluetooth >/dev/null 2>&1; then
    sudo usermod -aG bluetooth "$USER" 2>/dev/null \
      && ok "added $USER to 'bluetooth' group (log out/in to apply)"
  fi

  say "Fetching prebuilt aarch64 binaries (GitHub latest releases)"
  install_release_bin "librespeed/speedtest-cli" 'linux_arm64\.tar\.gz$' "librespeed-cli" "librespeed-cli (WAN speed test)"
  install_release_bin "orf/gping"        'aarch64-unknown-linux-(musl|gnu).*tar\.gz$|aarch64.*linux.*tar\.gz$' "gping"     "gping (ping graph)"
  install_release_bin "imsnif/bandwhich" 'aarch64-unknown-linux-(musl|gnu).*tar\.gz$|aarch64.*linux.*tar\.gz$' "bandwhich" "bandwhich (per-process bw)"
  install_release_bin "ducaale/xh"       'aarch64-unknown-linux-(musl|gnu).*tar\.gz$|aarch64.*linux.*tar\.gz$' "xh"        "xh (modern curl)"

  say "Setup complete"
  echo "Tip: run 'netkit selftest' to confirm everything resolves."
}

# ---------- self-test (bench check) ----------
do_selftest() {
  clear; banner
  echo " iface: ${IFACE:-?}  ip: ${SELFIP:-?}  gw: ${GW:-?}  wifi: ${WIFACE:-none}  wired: ${WIRED:-none}"
  echo
  say "Core tools"
  local t tools=(nmap arp-scan iperf3 mtr tcpdump dig lldpcli avahi-browse tmux gum)
  for t in "${tools[@]}"; do
    if have "$t"; then ok "$t"; else warn "$t MISSING"; fi
  done
  say "Optional extras"
  local x extras=(gping bandwhich xh librespeed-cli mosquitto_sub ethtool snmpwalk fping ipcalc wakeonlan bluetoothctl btmon rtl_433 rtl_power)
  for x in "${extras[@]}"; do
    if have "$x"; then ok "$x"; else warn "$x missing (run: netkit setup)"; fi
  done
  say "Live checks"
  if [ -n "$GW" ] && ping -c1 -W2 "$GW" >/dev/null 2>&1; then ok "gateway $GW reachable"
  elif [ -n "$GW" ]; then warn "gateway $GW not answering ping"
  else warn "no default gateway"; fi
  if [ -n "$CIDR" ]; then
    local up
    up="$(sudo nmap -sn "$CIDR" 2>/dev/null | grep -c 'Nmap scan report')"
    ok "nmap ping sweep $CIDR -> ${up:-0} host(s) up"
  fi
  echo
}

# ---------- self-update ----------
do_update() {
  local url="${1:-}"
  mkdir -p "$NETKIT_CFG_DIR"
  if [ -n "$url" ]; then
    printf '%s\n' "$url" > "$NETKIT_CFG_DIR/update.url"
  elif [ -f "$NETKIT_CFG_DIR/update.url" ]; then
    url="$(cat "$NETKIT_CFG_DIR/update.url")"
  fi
  if [ -z "$url" ]; then
    echo "No update URL set. Pass the Raw gist URL once and it'll be remembered:"
    echo "  netkit update 'https://gist.githubusercontent.com/<user>/<id>/raw/netkit'"
    exit 1
  fi
  local tmp; tmp="$(mktemp)"
  if ! curl -fsSL "$url" -o "$tmp"; then echo "Download failed: $url"; rm -f "$tmp"; exit 1; fi
  # Guard against grabbing the gist web page instead of Raw (the known footgun).
  if [ "$(head -1 "$tmp")" != "#!/usr/bin/env bash" ]; then
    echo "Refusing to install: fetched file isn't a bash script (got HTML?)."
    echo "Make sure you copied the *Raw* gist URL, not the gist web page."
    rm -f "$tmp"; exit 1
  fi
  if sudo install -m 0755 "$tmp" "$NETKIT_BIN"; then
    echo "Updated $NETKIT_BIN -> $(grep -m1 'NETKIT_VERSION=' "$NETKIT_BIN" | cut -d'"' -f2)"
  else
    echo "Install failed (need sudo rights to $NETKIT_BIN)."
  fi
  rm -f "$tmp"
}

# ---------- uninstall ----------
do_uninstall() {
  echo "This removes $NETKIT_BIN only."
  echo "It leaves apt packages and ~/netkit-reports in place."
  local a; a="$(ask "Remove netkit? (y/N):" "N")"
  case "$a" in
    y|Y|yes|YES) sudo rm -f "$NETKIT_BIN" && echo "Removed $NETKIT_BIN." ;;
    *) echo "Cancelled." ;;
  esac
}

usage() {
  cat <<EOF
netkit v${NETKIT_VERSION} — Pi 5 network toolkit
  netkit              interactive dashboard
  netkit dash         tiled live view (tmux)
  netkit report       write a markdown site snapshot
  netkit setup        install/refresh extra deps (MQTT, ethtool, SNMP, speedtest, …)
  netkit selftest     bench check: tools present + live sweep
  netkit update [URL] re-pull this script from a Raw gist URL (remembers it)
  netkit uninstall    remove the netkit binary
  netkit version      print version
EOF
}

# ---------- main ----------
case "${1:-}" in
  dash) run_dash; exit 0 ;;
  report) gen_report; exit 0 ;;
  setup|--setup) do_setup; exit 0 ;;
  selftest|--selftest) do_selftest; exit 0 ;;
  update|--update) do_update "${2:-}"; exit 0 ;;
  uninstall|--uninstall) do_uninstall; exit 0 ;;
  version|--version|-v) echo "netkit v${NETKIT_VERSION}"; exit 0 ;;
  help|--help|-h) usage; exit 0 ;;
esac

